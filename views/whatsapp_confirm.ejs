<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title>Envoyer sur WhatsApp</title>
  <style>
    body {
      font-family: 'Helvetica Neue', Arial, sans-serif;
      background: #ffffff;
      color: #000000;
      text-align: center;
      padding: 50px 20px;
      line-height: 1.6;
    }
    
    h1 {
      font-weight: 300;
      font-size: 24px;
      margin-bottom: 30px;
      letter-spacing: 1px;
    }

    .info-box {
      background: #f8f9fa;
      padding: 20px;
      border-radius: 10px;
      margin: 20px 0;
      text-align: left;
    }

    .info-box h3 {
      margin-top: 0;
      color: #000;
    }

    .lien-saas {
      background: #e8f5e8;
      padding: 15px;
      border-radius: 8px;
      margin: 15px 0;
      word-break: break-all;
    }

    .lien-saas a {
      color: #007bff;
      text-decoration: none;
      font-weight: bold;
    }
    
    .button-container {
      display: flex;
      flex-direction: column;
      gap: 15px;
      max-width: 300px;
      margin: 0 auto;
    }
    
    .btn {
      display: inline-block;
      padding: 15px 30px;
      text-decoration: none;
      font-weight: 400;
      font-size: 14px;
      text-transform: uppercase;
      letter-spacing: 1px;
      transition: all 0.3s ease;
      border: 1px solid #000000;
      cursor: pointer;
    }
    
    .btn-whatsapp {
      background: #25D366;
      color: #ffffff;
      border-color: #25D366;
    }
    
    .btn-whatsapp:hover {
      background: #ffffff;
      color: #25D366;
    }
    
    .btn-accueil {
      background: #ffffff;
      color: #000000;
    }
    
    .btn-accueil:hover {
      background: #000000;
      color: #ffffff;
    }

    .instructions {
      font-size: 14px;
      color: #666;
      margin: 20px 0;
    }
  </style>
</head>
<body>
  <h1>✅ Commande prête à être envoyée !</h1>


  <div class="instructions">
    💡 <strong>Le vendeur pourra :</strong><br>
    • Voir tous les produits avec photos<br>
    • Contacter le client directement<br>
    • Gérer le statut de la commande
  </div>
  
  <div class="button-container">
    <a href="https://wa.me/<%= numeroWhatsApp.replace(/\D/g, '') %>?text=<%= messageWhatsApp %>" 
       target="_blank" 
       rel="noopener noreferrer"
       class="btn btn-whatsapp">
      📤 Envoyer sur WhatsApp
    </a>
    
    <a href="/boutique/<%= slug %>" class="btn btn-accueil">
      🏠 Retour à l'accueil
    </a>
  </div>

  <script>
    // Notification de confirmation
    setTimeout(() => {
      alert('💡 Le vendeur recevra un lien vers la commande complète avec toutes les photos des produits !');
    }, 1000);
  </script>
</body>
</html>