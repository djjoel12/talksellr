<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>ShopFrii - Libérez-vous des DM Instagram</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
    :root {
      --primary: #4A90E2;
      --primary-dark: #357ABD;
      --primary-light: #E8F2FF;
      --secondary: #2C3E50;
      --accent: #6C63FF;
      --light: #ffffff;
      --dark: #1A1A1A;
      --gray-light: #F8FAFC;
      --gray: #64748B;
      --gray-dark: #334155;
      --success: #10B981;
      --warning: #F59E0B;
      --white: #ffffff;
      --black: #000000;
      --shadow: 0 4px 12px rgba(0, 0, 0, 0.08);
      --shadow-lg: 0 8px 24px rgba(0, 0, 0, 0.12);
      --transition: all 0.3s ease;
      --border: 1px solid #E2E8F0;
      --radius: 12px;
    }
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }
    body {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif;
      background-color: var(--light);
      color: var(--secondary);
      line-height: 1.6;
    }
    /* Header */
    .header {
      background: var(--white);
      border-bottom: 1px solid var(--border);
      padding: 1.2rem 0;
      position: sticky;
      top: 0;
      z-index: 100;
      box-shadow: var(--shadow);
    }
    .container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 1.5rem;
    }
    .header-content {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 1rem;
    }
    .logo {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      font-size: 1.6rem;
      font-weight: 800;
      color: var(--primary);
      text-decoration: none;
      text-transform: uppercase;
      letter-spacing: -0.5px;
    }
    .logo-icon {
      background: linear-gradient(135deg, var(--primary), var(--accent));
      color: var(--white);
      width: 44px;
      height: 44px;
      border-radius: 10px;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 4px 8px rgba(74, 144, 226, 0.3);
    }
    .nav {
      display: flex;
      align-items: center;
      gap: 1.5rem;
    }
    .btn {
      padding: 0.7rem 1.5rem;
      border-radius: 25px;
      text-decoration: none;
      font-weight: 600;
      transition: var(--transition);
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      border: none;
      cursor: pointer;
      font-size: 0.9rem;
    }
    .btn-outline {
      background: transparent;
      border: 2px solid var(--primary);
      color: var(--primary);
    }
    .btn-outline:hover {
      background: var(--primary);
      color: var(--white);
      transform: translateY(-2px);
      box-shadow: 0 6px 12px rgba(74, 144, 226, 0.2);
    }
    .btn-primary {
      background: linear-gradient(135deg, var(--primary), var(--accent));
      color: var(--white);
      box-shadow: 0 4px 8px rgba(74, 144, 226, 0.3);
    }
    .btn-primary:hover {
      background: linear-gradient(135deg, var(--primary-dark), var(--accent));
      transform: translateY(-2px);
      box-shadow: 0 6px 16px rgba(74, 144, 226, 0.4);
    }
    .btn-secondary {
      background: var(--secondary);
      color: var(--white);
      box-shadow: 0 4px 8px rgba(44, 62, 80, 0.2);
    }
    .btn-secondary:hover {
      background: var(--dark);
      transform: translateY(-2px);
      box-shadow: 0 6px 16px rgba(44, 62, 80, 0.3);
    }
    /* Hero Section */
    .hero {
      padding: 6rem 0;
      background: linear-gradient(135deg, var(--white) 0%, var(--primary-light) 100%);
      border-bottom: 1px solid var(--border);
      position: relative;
      overflow: hidden;
    }
    .hero::before {
      content: '';
      position: absolute;
      top: 0;
      right: 0;
      width: 300px;
      height: 300px;
      background: radial-gradient(circle, var(--accent) 0%, transparent 70%);
      opacity: 0.05;
      border-radius: 50%;
    }
    .hero-content {
      max-width: 800px;
      margin: 0 auto;
      text-align: center;
      position: relative;
      z-index: 2;
    }
    .hero h1 {
      font-size: 3.5rem;
      margin-bottom: 1.5rem;
      font-weight: 800;
      color: var(--secondary);
      line-height: 1.2;
    }
    .hero p {
      font-size: 1.3rem;
      margin-bottom: 2.5rem;
      color: var(--gray-dark);
      font-weight: 500;
    }
    .cta-section {
      display: flex;
      justify-content: center;
      gap: 1rem;
      margin-bottom: 3rem;
      flex-wrap: wrap;
    }
    .urgency-badge {
      background: linear-gradient(135deg, var(--warning), #FBBF24);
      color: white;
      padding: 0.5rem 1.5rem;
      border-radius: 25px;
      font-weight: 700;
      font-size: 0.9rem;
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      box-shadow: 0 4px 8px rgba(245, 158, 11, 0.3);
      margin-bottom: 1rem;
    }
    /* Pain Points Section */
    .pain-points {
      padding: 5rem 0;
      background: var(--gray-light);
    }
    .section-header {
      margin-bottom: 3rem;
      text-align: center;
    }
    .section-header h2 {
      font-size: 2.5rem;
      color: var(--secondary);
      margin-bottom: 1rem;
      font-weight: 800;
      position: relative;
      display: inline-block;
    }
    .section-header h2::after {
      content: '';
      position: absolute;
      bottom: -10px;
      left: 50%;
      transform: translateX(-50%);
      width: 80px;
      height: 4px;
      background: linear-gradient(135deg, var(--primary), var(--accent));
      border-radius: 2px;
    }
    .section-header p {
      color: var(--gray-dark);
      font-size: 1.1rem;
      max-width: 600px;
      margin: 0 auto;
    }
    .pain-points-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: 2rem;
      margin-top: 3rem;
    }
    .pain-point-card {
      background: var(--white);
      border-radius: var(--radius);
      padding: 2rem;
      box-shadow: var(--shadow);
      border-top: 4px solid var(--primary);
      transition: var(--transition);
      position: relative;
    }
    .pain-point-card:hover {
      transform: translateY(-5px);
      box-shadow: var(--shadow-lg);
    }
    .pain-icon {
      width: 60px;
      height: 60px;
      background: var(--primary-light);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 1.5rem;
      font-size: 1.5rem;
      color: var(--primary);
    }
    .pain-point-card h3 {
      font-size: 1.3rem;
      margin-bottom: 1rem;
      color: var(--secondary);
      font-weight: 700;
    }
    .pain-point-card p {
      color: var(--gray-dark);
      margin-bottom: 1.5rem;
      line-height: 1.6;
    }
    .solution {
      background: var(--success);
      color: white;
      padding: 0.75rem 1rem;
      border-radius: var(--radius);
      font-weight: 600;
      display: flex;
      align-items: center;
      gap: 0.5rem;
      margin-top: 1rem;
    }
    /* Solution Section */
    .solution-section {
      padding: 5rem 0;
      background: linear-gradient(135deg, var(--primary-light) 0%, var(--white) 100%);
    }
    .solution-content {
      max-width: 800px;
      margin: 0 auto;
      text-align: center;
    }
    .solution-features {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 2rem;
      margin: 3rem 0;
    }
    .feature-card {
      background: var(--white);
      padding: 2rem;
      border-radius: var(--radius);
      box-shadow: var(--shadow);
      text-align: center;
      transition: var(--transition);
    }
    .feature-card:hover {
      transform: translateY(-5px);
      box-shadow: var(--shadow-lg);
    }
    .feature-icon {
      width: 80px;
      height: 80px;
      background: linear-gradient(135deg, var(--primary), var(--accent));
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 1.5rem;
      font-size: 2rem;
      color: var(--white);
    }
    .feature-card h3 {
      font-size: 1.2rem;
      margin-bottom: 1rem;
      color: var(--secondary);
      font-weight: 700;
    }
    .feature-card p {
      color: var(--gray-dark);
      line-height: 1.6;
    }
    /* Offer Section */
    .offer-section {
      padding: 5rem 0;
      background: linear-gradient(135deg, var(--secondary), var(--dark));
      color: var(--white);
      text-align: center;
    }
    .offer-content {
      max-width: 800px;
      margin: 0 auto;
    }
    .offer-badge {
      background: linear-gradient(135deg, var(--primary), var(--accent));
      color: white;
      padding: 0.75rem 2rem;
      border-radius: 25px;
      font-weight: 700;
      font-size: 1.1rem;
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      margin-bottom: 2rem;
      box-shadow: 0 4px 8px rgba(74, 144, 226, 0.3);
    }
    .offer-features {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 1.5rem;
      margin: 2.5rem 0;
    }
    .offer-feature {
      background: rgba(255, 255, 255, 0.1);
      padding: 1.5rem;
      border-radius: var(--radius);
      backdrop-filter: blur(10px);
      border: 1px solid rgba(255, 255, 255, 0.1);
    }
    .offer-feature i {
      font-size: 2rem;
      margin-bottom: 1rem;
      color: var(--primary);
    }
    .offer-feature h4 {
      font-size: 1.1rem;
      margin-bottom: 0.5rem;
      font-weight: 700;
    }
    .offer-feature p {
      font-size: 0.9rem;
      opacity: 0.9;
    }
    .urgency-counter {
      background: rgba(255, 255, 255, 0.1);
      padding: 1rem 2rem;
      border-radius: var(--radius);
      display: inline-flex;
      align-items: center;
      gap: 1rem;
      margin: 2rem 0;
      backdrop-filter: blur(10px);
      border: 1px solid rgba(255, 255, 255, 0.1);
    }
    .counter-number {
      font-size: 2rem;
      font-weight: 800;
      color: var(--primary);
    }
    /* Guarantee Section */
    .guarantee-section {
      padding: 4rem 0;
      background: var(--white);
      text-align: center;
    }
    .guarantee-card {
      background: linear-gradient(135deg, var(--primary-light), var(--white));
      padding: 3rem;
      border-radius: var(--radius);
      box-shadow: var(--shadow);
      max-width: 600px;
      margin: 0 auto;
      border: 2px solid var(--primary-light);
    }
    .guarantee-icon {
      width: 80px;
      height: 80px;
      background: linear-gradient(135deg, var(--primary), var(--accent));
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 1.5rem;
      font-size: 2rem;
      color: var(--white);
    }
    /* Footer */
    .footer {
      background: var(--secondary);
      color: var(--white);
      padding: 4rem 0 2rem;
    }
    .footer-content {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 3rem;
      margin-bottom: 3rem;
    }
    .footer-column h3 {
      font-size: 1.3rem;
      margin-bottom: 1.5rem;
      font-weight: 700;
      color: var(--white);
      position: relative;
      padding-bottom: 0.5rem;
    }
    .footer-column h3::after {
      content: '';
      position: absolute;
      bottom: 0;
      left: 0;
      width: 40px;
      height: 3px;
      background: var(--primary);
      border-radius: 2px;
    }
    .footer-links {
      list-style: none;
    }
    .footer-links li {
      margin-bottom: 0.75rem;
    }
    .footer-links a {
      color: #CBD5E1;
      text-decoration: none;
      transition: var(--transition);
      display: flex;
      align-items: center;
      gap: 0.5rem;
      font-size: 0.95rem;
    }
    .footer-links a:hover {
      color: var(--primary);
      transform: translateX(5px);
    }
    .footer-bottom {
      text-align: center;
      padding-top: 2rem;
      border-top: 1px solid var(--gray-dark);
      color: #94A3B8;
      font-size: 0.9rem;
    }
    /* Responsive */
    @media (max-width: 768px) {
      .header-content {
        flex-direction: column;
        text-align: center;
      }
      .nav {
        width: 100%;
        justify-content: center;
        flex-wrap: wrap;
      }
      .hero h1 {
        font-size: 2.5rem;
      }
      .hero p {
        font-size: 1.1rem;
      }
      .cta-section {
        flex-direction: column;
        align-items: center;
      }
      .pain-points-grid,
      .solution-features,
      .offer-features {
        grid-template-columns: 1fr;
      }
      .section-header h2 {
        font-size: 2rem;
      }
    }
    @media (max-width: 480px) {
      .hero h1 {
        font-size: 2rem;
      }
      .section-header h2 {
        font-size: 1.8rem;
      }
      .pain-point-card,
      .feature-card,
      .guarantee-card {
        padding: 1.5rem;
      }
    }
  </style>
</head>
<body>
  <!-- Header -->
  <header class="header">
    <div class="container">
      <div class="header-content">
        <a href="/" class="logo">
          <div class="logo-icon">
            <i class="fas fa-rocket"></i>
          </div>
          <span>ShopFrii</span>
        </a>
        <nav class="nav">
          <a href="/auth/login" class="btn btn-outline">
            <i class="fas fa-sign-in-alt"></i> Connexion
          </a>
          <a href="#offer" class="btn btn-primary">
            <i class="fas fa-bolt"></i> Essai Gratuit
          </a>
        </nav>
      </div>
    </div>
  </header>
  <!-- Hero Section -->
  <section class="hero">
    <div class="container">
      <div class="hero-content">
        <div class="urgency-badge">
          <i class="fas fa-exclamation-circle"></i> OFFRE BÊTA EXCEPTIONNELLE
        </div>
       
        <h1>Épuisé(e) de passer votre vie sur les DM ?</h1>
        <p><strong>Shopfrii automatise 80% de votre travail de vente</strong>, pour que vous puissiez enfin vous concentrer sur ce qui compte vraiment : développer votre business et retrouver votre vie.</p>
       
        <div class="cta-section">
          <a href="#offer" class="btn btn-primary" style="padding: 1rem 2rem; font-size: 1.1rem;">
            <i class="fas fa-bolt"></i> JE VEUX REPRENDRE MA VIE EN MAIN
          </a>
          <a href="#solution" class="btn btn-outline" style="padding: 1rem 2rem; font-size: 1.1rem;">
            <i class="fas fa-play-circle"></i> Voir la démo
          </a>
        </div>
      </div>
    </div>
  </section>
  <!-- Pain Points Section -->
  <section class="pain-points" id="problems">
    <div class="container">
      <div class="section-header">
        <h2>Les 5 frustrations qui vous empêchent de scaler</h2>
        <p>Vous reconnaissez-vous dans l'une de ces situations ?</p>
      </div>
      <div class="pain-points-grid">
        <!-- Point 1 -->
        <div class="pain-point-card">
          <div class="pain-icon">
            <i class="fas fa-comment-dots"></i>
          </div>
          <h3>"C'EST DISPONIBLE ?" - LA MÊME QUESTION 50 FOIS/JOUR</h3>
          <p>Finis les messages répétitifs qui vous prennent 2h par jour. Cette frustration constante qui vous empêche de vous concentrer sur votre croissance.</p>
          <div class="solution">
            <i class="fas fa-check-circle"></i>
            <span>Vos clients voient directement les stocks et prix</span>
          </div>
        </div>
        <!-- Point 2 -->
        <div class="pain-point-card">
          <div class="pain-icon">
            <i class="fas fa-envelope"></i>
          </div>
          <h3>VENTES PERDUES DANS LES MESSAGES NON LUS</h3>
          <p>Combien de ventes avez-vous perdues dans l'oubli des DM ? Ces opportunités manquées qui grignotent votre chiffre d'affaires.</p>
          <div class="solution">
            <i class="fas fa-check-circle"></i>
            <span>Boutique organisée = zéro vente perdue</span>
          </div>
        </div>
        <!-- Point 3 -->
        <div class="pain-point-card">
          <div class="pain-icon">
            <i class="fas fa-clock"></i>
          </div>
          <h3>LA JOURNÉE DE 25 HEURES</h3>
          <p>Vendre sur Instagram = un deuxième travail à temps plein. Cette fatigue constante qui vous éloigne de votre famille et de vos passions.</p>
          <div class="solution">
            <i class="fas fa-check-circle"></i>
            <span>Récupérez 15h par semaine pour votre vie</span>
          </div>
        </div>
        <!-- Point 4 -->
        <div class="pain-point-card">
          <div class="pain-icon">
            <i class="fas fa-tasks"></i>
          </div>
          <h3>LE STRESS DES COMMANDES EN VRAC</h3>
          <p>La peur d'oublier une commande, de se tromper de taille... Ce stress permanent qui vous empêche de dormir sur vos deux oreilles.</p>
          <div class="solution">
            <i class="fas fa-check-circle"></i>
            <span>Système de commandes automatisé et infaillible</span>
          </div>
        </div>
        <!-- Point 5 -->
        <div class="pain-point-card">
          <div class="pain-icon">
            <i class="fas fa-chart-line"></i>
          </div>
          <h3>LA CROISSANCE BLOQUÉE</h3>
          <p>Impossible de scaler quand on passe sa vie à gérer les DM. Ce plafond de verre qui vous empêche d'atteindre votre plein potentiel.</p>
          <div class="solution">
            <i class="fas fa-check-circle"></i>
            <span>Passez de 10 à 100 commandes/jour sans embaucher</span>
          </div>
        </div>
      </div>
    </div>
  </section>
  <!-- Solution Section -->
  <section class="solution-section" id="solution">
    <div class="container">
      <div class="solution-content">
        <div class="section-header">
          <h2>La solution ShopFrii</h2>
          <p><strong>Notre promesse :</strong> Vous reprenez le contrôle de votre temps et multipliez vos ventes, ou on vous rembourse.</p>
        </div>
        <div class="solution-features">
          <div class="feature-card">
            <div class="feature-icon">
              <i class="fas fa-bolt"></i>
            </div>
            <h3>Boutique pro en 10 minutes</h3>
            <p>Transformez votre compte Instagram en boutique professionnelle en quelques clics seulement</p>
          </div>
          <div class="feature-card">
            <div class="feature-icon">
              <i class="fas fa-magic"></i>
            </div>
            <h3>Zéro compétence technique</h3>
            <p>Interface intuitive conçue pour les vendeurs, pas pour les développeurs</p>
          </div>
          <div class="feature-card">
            <div class="feature-icon">
              <i class="fas fa-euro-sign"></i>
            </div>
            <h3>Prix imbattable</h3>
            <p>Moins cher qu'un repas au restaurant par mois. Investissement rapidement rentabilisé</p>
          </div>
        </div>
      </div>
    </div>
  </section>
  <!-- Offer Section -->
  <section class="offer-section" id="offer">
    <div class="container">
      <div class="offer-content">
        <div class="offer-badge">
          <i class="fas fa-gift"></i> OFFRE BÊTA EXCEPTIONNELLE
        </div>
        <h2 style="color: white; margin-bottom: 1.5rem; font-size: 2.5rem;">Les 20 premiers vendeurs reçoivent :</h2>
        <div class="offer-features">
          <div class="offer-feature">
            <i class="fas fa-crown"></i>
            <h4>3 mois GRATUITS</h4>
            <p>Profitez de tous les avantages sans engagement</p>
          </div>
          <div class="offer-feature">
            <i class="fas fa-headset"></i>
            <h4>Support personnel</h4>
            <p>Un expert dédié à votre réussite</p>
          </div>
          <div class="offer-feature">
            <i class="fas fa-lightbulb"></i>
            <h4>Influence les features</h4>
            <p>Participez au développement de ShopFrii</p>
          </div>
          <div class="offer-feature">
            <i class="fas fa-star"></i>
            <h4>Outils premium</h4>
            <p>Accès aux fonctionnalités avancées</p>
          </div>
        </div>
        <div class="urgency-counter">
          <div class="counter-number">5</div>
          <div>places restantes !</div>
        </div>
        <a href="/auth/register" class="btn btn-primary" style="padding: 1.2rem 3rem; font-size: 1.2rem;">
          <i class="fas fa-bolt"></i> JE VEUX REPRENDRE MA VIE EN MAIN
        </a>
      </div>
    </div>
  </section>
  <!-- Guarantee Section -->
  <section class="guarantee-section">
    <div class="container">
      <div class="guarantee-card">
        <div class="guarantee-icon">
          <i class="fas fa-shield-alt"></i>
        </div>
        <h2 style="margin-bottom: 1rem;">Garantie "Zéro Risque"</h2>
        <p style="font-size: 1.2rem; margin-bottom: 1.5rem; font-weight: 600;">
          Essai 7 jours sans engagement :
        </p>
        <p style="font-size: 1.1rem; margin-bottom: 2rem;">
          Si ShopFrii ne vous fait pas gagner au moins 1h par jour dès la première semaine, on vous offre 2 mois d'abonnement gratuit !
        </p>
        <a href="/auth/register" class="btn btn-primary" style="padding: 1rem 2.5rem; font-size: 1.1rem;">
          <i class="fas fa-play-circle"></i> Essayer Gratuitement
        </a>
      </div>
    </div>
  </section>
  <!-- Final Message -->
  <section style="padding: 4rem 0; background: var(--primary-light); text-align: center;">
    <div class="container">
      <h2 style="font-size: 2rem; margin-bottom: 1.5rem; color: var(--secondary);">
        Vous méritez mieux que de passer votre vie sur les DM.
      </h2>
      <p style="font-size: 1.3rem; margin-bottom: 2rem; color: var(--gray-dark); font-weight: 500;">
