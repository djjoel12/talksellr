<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= boutique.nom %> - Collection Exclusive</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
    :root {
      --lv-dark: #000000;
      --lv-gold: #C9A96E;
      --lv-beige: #F5F5F0;
      --lv-white: #FFFFFF;
      --lv-light-gray: #F8F8F8;
      --lv-text: #1A1A1A;
      --lv-border: #DDDDDD;
      --transition-luxe: cubic-bezier(0.25, 0.46, 0.45, 0.94);
    }
   
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }
   
    body {
      font-family: 'Helvetica Neue', Arial, sans-serif;
      color: var(--lv-text);
      background: var(--lv-white);
      line-height: 1.5;
      font-weight: 300;
      min-height: 100vh;
      overflow-x: hidden;
    }

    /* Header Louis Vuitton */
    header {
      background: var(--lv-white);
      border-bottom: 1px solid var(--lv-border);
      padding: 1rem 0;
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      z-index: 1000;
      backdrop-filter: blur(20px);
    }
   
    .header-container {
      max-width: 1400px;
      margin: 0 auto;
      padding: 0 1rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
   
    .logo {
      font-size: 1.2rem;
      font-weight: 300;
      letter-spacing: 2px;
      color: var(--lv-dark);
      text-transform: uppercase;
      text-decoration: none;
      z-index: 1001;
    }

    .nav-links {
      display: flex;
      gap: 2rem;
    }

    .nav-links a {
      font-size: 0.75rem;
      font-weight: 300;
      letter-spacing: 1.2px;
      text-transform: uppercase;
      color: var(--lv-dark);
      text-decoration: none;
      transition: color 0.3s ease;
    }

    .nav-links a:hover {
      color: var(--lv-gold);
    }

    .header-actions {
      display: flex;
      gap: 1rem;
      align-items: center;
    }

    .icon-btn {
      background: none;
      border: none;
      color: var(--lv-dark);
      font-size: 1.1rem;
      cursor: pointer;
      transition: color 0.3s ease;
      position: relative;
      padding: 0.5rem;
      min-width: 44px;
      min-height: 44px;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .icon-btn:hover {
      color: var(--lv-gold);
    }

    .cart-badge {
      position: absolute;
      top: 2px;
      right: 2px;
      background: var(--lv-gold);
      color: var(--lv-dark);
      border-radius: 50%;
      width: 18px;
      height: 18px;
      font-size: 0.7rem;
      font-weight: 600;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .menu-toggle {
      display: none;
      background: none;
      border: none;
      color: var(--lv-dark);
      font-size: 1.2rem;
      cursor: pointer;
      padding: 0.5rem;
      min-width: 44px;
      min-height: 44px;
      z-index: 1001;
    }

    /* Hero Section Éditoriale LV */
    .hero-editorial {
      height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      background: linear-gradient(135deg, var(--lv-dark) 0%, #1a1a1a 100%);
      position: relative;
      overflow: hidden;
      margin-top: 60px;
    }

    .hero-content {
      text-align: center;
      color: var(--lv-white);
      z-index: 2;
      max-width: 90%;
      padding: 0 1rem;
    }

    .hero-title {
      font-size: clamp(2rem, 8vw, 4rem);
      font-weight: 300;
      letter-spacing: 3px;
      text-transform: uppercase;
      margin-bottom: 1.5rem;
      line-height: 1.1;
    }

    .hero-subtitle {
      font-size: clamp(0.9rem, 3vw, 1.2rem);
      font-weight: 300;
      letter-spacing: 1.5px;
      margin-bottom: 2.5rem;
      opacity: 0.8;
      line-height: 1.6;
      padding: 0 1rem;
    }

    .hero-cta {
      display: inline-block;
      padding: clamp(1rem, 3vw, 1.5rem) clamp(2rem, 6vw, 4rem);
      border: 2px solid var(--lv-gold);
      color: var(--lv-white);
      text-decoration: none;
      text-transform: uppercase;
      letter-spacing: 1.5px;
      font-size: clamp(0.8rem, 2vw, 0.9rem);
      transition: all 0.3s ease;
      min-height: 50px;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .hero-cta:hover {
      background: var(--lv-gold);
      color: var(--lv-dark);
    }

    /* Collection Horizontale LV */
    .collection-horizontal {
      padding: 4rem 0;
      background: var(--lv-beige);
      position: relative;
    }

    .collection-header {
      text-align: center;
      margin-bottom: 3rem;
      padding: 0 1rem;
    }

    .collection-title {
      font-size: clamp(1.8rem, 5vw, 2.5rem);
      font-weight: 300;
      letter-spacing: 2px;
      text-transform: uppercase;
      margin-bottom: 1rem;
      color: var(--lv-dark);
    }

    .collection-subtitle {
      font-size: clamp(0.9rem, 2vw, 1rem);
      font-weight: 300;
      letter-spacing: 1.2px;
      color: var(--lv-text);
      opacity: 0.7;
      max-width: 90%;
      margin: 0 auto;
      line-height: 1.5;
    }

    /* Barre de défilement horizontale */
    .scroll-container {
      position: relative;
      padding: 0 1rem;
    }

    .scroll-indicator {
      position: absolute;
      right: 1rem;
      top: 50%;
      transform: translateY(-50%);
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.5rem;
      z-index: 10;
    }

    .scroll-text {
      font-size: 0.7rem;
      font-weight: 300;
      letter-spacing: 1px;
      color: var(--lv-dark);
      text-transform: uppercase;
      writing-mode: vertical-rl;
      text-orientation: mixed;
    }

    .scroll-arrow {
      width: 1px;
      height: 40px;
      background: var(--lv-dark);
      position: relative;
    }

    .scroll-arrow::after {
      content: '';
      position: absolute;
      bottom: -5px;
      left: -3px;
      width: 7px;
      height: 7px;
      border-right: 1px solid var(--lv-dark);
      border-bottom: 1px solid var(--lv-dark);
      transform: rotate(45deg);
    }

    .horizontal-scroll {
      display: flex;
      overflow-x: auto;
      gap: 1.5rem;
      padding: 1.5rem 0;
      scrollbar-width: none;
      -ms-overflow-style: none;
      scroll-behavior: smooth;
      scroll-padding: 0 1rem;
    }

    .horizontal-scroll::-webkit-scrollbar {
      display: none;
    }

    .product-card-horizontal {
      min-width: min(85vw, 300px);
      background: var(--lv-white);
      position: relative;
      transition: transform 0.3s ease;
      cursor: pointer;
      flex-shrink: 0;
      border-radius: 4px;
      overflow: hidden;
    }

    .product-card-horizontal:hover {
      transform: translateY(-5px);
    }

    .product-image {
      width: 100%;
      height: min(60vh, 400px);
      object-fit: cover;
    }

    .product-info-overlay {
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      background: linear-gradient(transparent, rgba(0,0,0,0.9));
      color: var(--lv-white);
      padding: 1.5rem;
      opacity: 0;
      transition: opacity 0.3s ease;
    }

    .product-card-horizontal:hover .product-info-overlay {
      opacity: 1;
    }

    .product-name {
      font-size: 1rem;
      font-weight: 300;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      margin-bottom: 0.5rem;
      line-height: 1.3;
    }

    .product-price {
      font-size: 1rem;
      font-weight: 300;
      letter-spacing: 1px;
      margin-bottom: 1rem;
    }

    .product-actions {
      display: flex;
      gap: 0.8rem;
      opacity: 0;
      transform: translateY(10px);
      transition: all 0.3s ease 0.1s;
    }

    .product-card-horizontal:hover .product-actions {
      opacity: 1;
      transform: translateY(0);
    }

    .product-btn {
      padding: 0.8rem 1rem;
      border: 1px solid var(--lv-white);
      background: transparent;
      color: var(--lv-white);
      text-transform: uppercase;
      letter-spacing: 1.2px;
      font-size: 0.7rem;
      cursor: pointer;
      transition: all 0.3s ease;
      text-decoration: none;
      flex: 1;
      text-align: center;
      min-height: 44px;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .product-btn-primary {
      background: var(--lv-white);
      color: var(--lv-dark);
    }

    .product-btn-primary:hover {
      background: var(--lv-gold);
      border-color: var(--lv-gold);
      color: var(--lv-dark);
    }

    .product-btn-outline:hover {
      background: var(--lv-white);
      color: var(--lv-dark);
    }

    /* Lookbook Section avec Produits */
    .lookbook-section {
      padding: 4rem 0;
      background: var(--lv-white);
    }

    .lookbook-grid {
      display: grid;
      grid-template-columns: 2fr 1fr;
      gap: 1.5rem;
      max-width: 1400px;
      margin: 0 auto;
      padding: 0 1rem;
    }

    .lookbook-main {
      position: relative;
    }

    .lookbook-main-product {
      width: 100%;
      height: min(80vh, 600px);
      object-fit: cover;
      cursor: pointer;
      transition: transform 0.3s ease;
    }

    .lookbook-main-product:hover {
      transform: scale(1.02);
    }

    .lookbook-side {
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
    }

    .lookbook-side-product {
      width: 100%;
      height: calc((min(80vh, 600px) - 1.5rem) / 2);
      object-fit: cover;
      cursor: pointer;
      transition: transform 0.3s ease;
    }

    .lookbook-side-product:hover {
      transform: scale(1.05);
    }

    .lookbook-content {
      position: absolute;
      bottom: 2rem;
      left: 2rem;
      color: var(--lv-white);
      max-width: 90%;
      padding: 0 1rem;
    }

    .lookbook-title {
      font-size: clamp(1.5rem, 4vw, 2rem);
      font-weight: 300;
      letter-spacing: 2px;
      text-transform: uppercase;
      margin-bottom: 1rem;
      line-height: 1.2;
    }

    .lookbook-description {
      font-size: clamp(0.9rem, 2vw, 1rem);
      font-weight: 300;
      letter-spacing: 1.2px;
      line-height: 1.5;
      margin-bottom: 1.5rem;
      opacity: 0.9;
    }

    .lookbook-cta {
      display: inline-block;
      padding: 0.8rem 1.5rem;
      border: 1px solid var(--lv-white);
      color: var(--lv-white);
      text-decoration: none;
      text-transform: uppercase;
      letter-spacing: 1.2px;
      font-size: 0.75rem;
      transition: all 0.3s ease;
      min-height: 44px;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .lookbook-cta:hover {
      background: var(--lv-white);
      color: var(--lv-dark);
    }

    /* Produits Éditoriaux */
    .editorial-products {
      padding: 4rem 0;
      background: var(--lv-beige);
    }

    .editorial-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 2rem;
      max-width: 1400px;
      margin: 0 auto;
      padding: 0 1rem;
    }

    .editorial-image {
      width: 100%;
      height: min(70vh, 500px);
      object-fit: cover;
      cursor: pointer;
      transition: transform 0.3s ease;
    }

    .editorial-image:hover {
      transform: scale(1.02);
    }

    .editorial-content {
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding: 1.5rem;
    }

    .editorial-product-name {
      font-size: clamp(1.5rem, 4vw, 2rem);
      font-weight: 300;
      letter-spacing: 2px;
      text-transform: uppercase;
      margin-bottom: 1rem;
      color: var(--lv-dark);
      line-height: 1.2;
    }

    .editorial-product-description {
      font-size: clamp(0.9rem, 2vw, 1rem);
      font-weight: 300;
      letter-spacing: 1.2px;
      line-height: 1.5;
      margin-bottom: 1.5rem;
      color: var(--lv-text);
      opacity: 0.8;
    }

    .editorial-product-price {
      font-size: clamp(1.1rem, 3vw, 1.3rem);
      font-weight: 300;
      letter-spacing: 1.5px;
      margin-bottom: 1.5rem;
      color: var(--lv-dark);
    }

    .editorial-actions {
      display: flex;
      gap: 1rem;
    }

    .editorial-btn {
      padding: 1rem 2rem;
      border: 1px solid var(--lv-dark);
      background: transparent;
      color: var(--lv-dark);
      text-transform: uppercase;
      letter-spacing: 1.5px;
      font-size: 0.75rem;
      cursor: pointer;
      transition: all 0.3s ease;
      text-decoration: none;
      display: inline-block;
      text-align: center;
      min-height: 50px;
      display: flex;
      align-items: center;
      justify-content: center;
      flex: 1;
    }

    .editorial-btn-primary {
      background: var(--lv-dark);
      color: var(--lv-white);
    }

    .editorial-btn-primary:hover {
      background: var(--lv-gold);
      border-color: var(--lv-gold);
      color: var(--lv-dark);
    }

    .editorial-btn-outline:hover {
      background: var(--lv-dark);
      color: var(--lv-white);
    }

    /* Footer Louis Vuitton */
    footer {
      background: var(--lv-dark);
      color: var(--lv-white);
      padding: 4rem 0 2rem;
    }

    .footer-content {
      max-width: 1400px;
      margin: 0 auto;
      padding: 0 1rem;
      display: grid;
      grid-template-columns: 2fr 1fr 1fr 1fr;
      gap: 3rem;
    }

    .footer-column h3 {
      font-size: 0.85rem;
      margin-bottom: 1.5rem;
      font-weight: 500;
      color: var(--lv-gold);
      text-transform: uppercase;
      letter-spacing: 2px;
    }
   
    .footer-links {
      list-style: none;
    }
   
    .footer-links li {
      margin-bottom: 0.8rem;
    }
   
    .footer-links a {
      color: rgba(255,255,255,0.7);
      transition: all 0.3s ease;
      font-size: 0.75rem;
      font-weight: 300;
      letter-spacing: 1px;
      text-transform: uppercase;
      text-decoration: none;
    }
   
    .footer-links a:hover {
      color: var(--lv-gold);
    }
   
    .social-links {
      display: flex;
      gap: 0.8rem;
      margin-top: 1.5rem;
    }
   
    .social-link {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 40px;
      height: 40px;
      background: rgba(255,255,255,0.1);
      color: var(--lv-white);
      border: 1px solid rgba(255,255,255,0.2);
      transition: all 0.3s ease;
      font-size: 1rem;
      text-decoration: none;
    }
   
    .social-link:hover {
      background: var(--lv-gold);
      color: var(--lv-dark);
    }
   
    .footer-bottom {
      text-align: center;
      padding-top: 3rem;
      border-top: 1px solid rgba(255,255,255,0.1);
      color: rgba(255,255,255,0.5);
      font-size: 0.7rem;
      font-weight: 300;
      letter-spacing: 1.2px;
      text-transform: uppercase;
      line-height: 1.5;
      max-width: 1400px;
      margin: 0 auto;
      padding-left: 1rem;
      padding-right: 1rem;
    }

    /* Notification Panier */
    .cart-notification {
      position: fixed;
      top: 80px;
      right: 1rem;
      left: 1rem;
      background: var(--lv-dark);
      color: var(--lv-gold);
      padding: 1.2rem;
      border: 1px solid var(--lv-gold);
      box-shadow: 0 15px 40px rgba(0,0,0,0.3);
      z-index: 9999;
      transform: translateX(400px);
      opacity: 0;
      transition: all 0.5s var(--transition-luxe);
      max-width: 400px;
      margin: 0 auto;
    }

    .cart-notification.show {
      transform: translateX(0);
      opacity: 1;
    }

    .notification-content {
      display: flex;
      align-items: center;
      gap: 1rem;
    }

    .notification-icon {
      font-size: 1.2rem;
      color: var(--lv-gold);
    }

    .notification-text {
      flex: 1;
    }

    .notification-title {
      font-size: 0.75rem;
      font-weight: 500;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      margin-bottom: 0.3rem;
      color: var(--lv-gold);
    }

    .notification-message {
      font-size: 0.7rem;
      font-weight: 300;
      letter-spacing: 1px;
      opacity: 0.9;
      color: var(--lv-white);
      line-height: 1.4;
    }

    /* Animation pour le badge */
    @keyframes pulse {
      0% { transform: scale(1); }
      50% { transform: scale(1.2); }
      100% { transform: scale(1); }
    }

    .cart-badge {
      animation: pulse 0.5s ease-in-out;
    }

    /* ========== RESPONSIVE CORRECTIONS ========== */

    /* Tablette */
    @media (max-width: 1024px) {
      .header-container {
        padding: 0 1.5rem;
      }

      .nav-links {
        gap: 1.5rem;
      }

      .footer-content {
        grid-template-columns: 1fr 1fr;
        gap: 2rem;
      }

      .editorial-grid {
        gap: 1.5rem;
      }
    }

    /* Mobile */
    @media (max-width: 768px) {
      .header-container {
        padding: 0 1rem;
      }

      /* Navigation mobile */
      .nav-links {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100vh;
        background: var(--lv-white);
        flex-direction: column;
        justify-content: center;
        align-items: center;
        gap: 2rem;
        transform: translateX(-100%);
        transition: transform 0.3s ease;
        z-index: 1000;
      }

      .nav-links.active {
        transform: translateX(0);
      }

      .nav-links a {
        font-size: 1.1rem;
        padding: 1rem 2rem;
      }

      .menu-toggle {
        display: flex;
        align-items: center;
        justify-content: center;
      }

      /* Hero adjustments */
      .hero-editorial {
        margin-top: 70px;
        height: calc(100vh - 70px);
      }

      .hero-content {
        max-width: 95%;
      }

      /* Collection horizontale */
      .scroll-indicator {
        display: none;
      }

      .product-card-horizontal {
        min-width: 280px;
      }

      /* Lookbook devient vertical */
      .lookbook-grid {
        grid-template-columns: 1fr;
        gap: 1rem;
      }

      .lookbook-side {
        flex-direction: row;
        gap: 1rem;
      }

      .lookbook-side-product {
        height: 200px;
      }

      .lookbook-content {
        position: relative;
        bottom: auto;
        left: auto;
        padding: 1.5rem;
        color: var(--lv-dark);
        background: rgba(255,255,255,0.9);
        margin-top: -100px;
        max-width: 100%;
      }

      /* Éditorial devient vertical */
      .editorial-grid {
        grid-template-columns: 1fr;
        gap: 1.5rem;
      }

      .editorial-actions {
        flex-direction: column;
      }

      .editorial-btn {
        flex: none;
      }

      /* Footer devient vertical */
      .footer-content {
        grid-template-columns: 1fr;
        gap: 2rem;
        text-align: center;
      }

      .social-links {
        justify-content: center;
      }
    }

    /* Petit mobile */
    @media (max-width: 480px) {
      .header-container {
        padding: 0 0.5rem;
      }

      .logo {
        font-size: 1rem;
        letter-spacing: 1px;
      }

      .hero-title {
        letter-spacing: 2px;
      }

      .collection-title {
        letter-spacing: 1.5px;
      }

      .product-card-horizontal {
        min-width: 260px;
      }

      .product-actions {
        flex-direction: column;
      }

      .lookbook-side {
        flex-direction: column;
      }

      .lookbook-side-product {
        height: 150px;
      }

      .footer-content {
        gap: 1.5rem;
      }
    }

    /* Touch device optimizations */
    @media (hover: none) {
      .product-card-horizontal:hover {
        transform: none;
      }

      .product-info-overlay {
        opacity: 1;
        background: linear-gradient(transparent, rgba(0,0,0,0.7));
      }

      .product-actions {
        opacity: 1;
        transform: translateY(0);
      }
    }
  </style>
</head>
<body>
  <!-- Notification Panier -->
  <div id="cartNotification" class="cart-notification">
    <div class="notification-content">
      <div class="notification-icon">✓</div>
      <div class="notification-text">
        <div class="notification-title">PRODUIT AJOUTÉ</div>
        <div class="notification-message" id="notificationMessage">Le produit a été ajouté à votre panier</div>
      </div>
    </div>
  </div>

  <!-- Header -->
  <header>
    <div class="header-container">
      <a href="#" class="logo"><%= boutique.nom %></a>
      
      <button class="menu-toggle" id="menuToggle">
        <i class="fas fa-bars"></i>
      </button>
      
      <nav class="nav-links" id="navLinks">
        <a href="#collection">NOUVELLE COLLECTION</a>
        <a href="#lookbook">LOOKBOOK</a>
        <a href="#editorial">ÉDITORIAL</a>
        <a href="#contact">CONTACT</a>
      </nav>
      
      <div class="header-actions">
        <button class="icon-btn">
          <i class="fas fa-search"></i>
        </button>
        <a href="/panier" class="icon-btn" style="position: relative;">
          <i class="fas fa-shopping-bag"></i>
          <% if (typeof panierCount !== 'undefined' && panierCount > 0) { %>
            <span class="cart-badge" id="cartBadge"><%= panierCount %></span>
          <% } %>
        </a>
        <button class="icon-btn">
          <i class="fas fa-user"></i>
        </button>
      </div>
    </div>
  </header>

  <!-- Hero Section Éditoriale -->
  <section class="hero-editorial">
    <div class="hero-content">
      <h1 class="hero-title">COLLECTION AUTOMNE 2024</h1>
      <p class="hero-subtitle">Découvrez l'essence du luxe contemporain à travers nos pièces signature, alliant savoir-faire artisanal et design avant-gardiste.</p>
      <a href="#collection" class="hero-cta">Explorer la collection</a>
    </div>
  </section>

  <!-- Collection Horizontale -->
  <section class="collection-horizontal" id="collection">
    <div class="collection-header">
      <h2 class="collection-title">NOUVELLES CRÉATIONS</h2>
      <p class="collection-subtitle">Pièces exclusives réinterprétant les codes de la marque avec modernité</p>
    </div>
    
    <div class="scroll-container">
      <!-- Barre de défilement horizontale -->
      <div class="scroll-indicator">
        <span class="scroll-text">Défiler</span>
        <div class="scroll-arrow"></div>
      </div>
      
      <div class="horizontal-scroll" id="horizontalScroll">
        <% produits.forEach((produit, index) => { %>
          <div class="product-card-horizontal" data-product-id="<%= produit._id %>">
            <img src="<%= produit.imagesGallery && produit.imagesGallery[0] ? produit.imagesGallery[0].url : produit.image %>" 
                 alt="<%= produit.nom %>" 
                 class="product-image">
            <div class="product-info-overlay">
              <h3 class="product-name"><%= produit.nom %></h3>
              <p class="product-price"><%= produit.prix %> <%= produit.devise %></p>
              <div class="product-actions">
                <a href="/boutique/produit/<%= produit._id %>" class="product-btn product-btn-outline">Découvrir</a>
                <button class="product-btn product-btn-primary add-to-cart-horizontal" 
                        data-product-id="<%= produit._id %>"
                        data-product-name="<%= produit.nom %>"
                        data-product-price="<%= produit.prix %>">
                  Ajouter au panier
                </button>
              </div>
            </div>
          </div>
        <% }); %>
      </div>
    </div>
  </section>

  <!-- Lookbook Section avec Produits du Vendeur -->
  <section class="lookbook-section" id="lookbook">
    <div class="lookbook-grid">
      <div class="lookbook-main">
        <!-- PRODUIT PRINCIPAL DU VENDEUR -->
        <% if (produits[3]) { %>
          <img src="<%= produits[3].imagesGallery && produits[3].imagesGallery[0] ? produits[3].imagesGallery[0].url : produits[3].image %>" 
               alt="<%= produits[3].nom %>" 
               class="lookbook-main-product"
               onclick="window.location.href='/boutique/produit/<%= produits[3]._id %>'">
          <div class="lookbook-content">
            <h3 class="lookbook-title"><%= produits[3].nom %></h3>
            <p class="lookbook-description"><%= produits[3].description || 'Pièce signature mettant en valeur l\'excellence de notre savoir-faire artisanal.' %></p>
            <a href="/boutique/produit/<%= produits[3]._id %>" class="lookbook-cta">Découvrir ce produit</a>
          </div>
        <% } %>
      </div>
      <div class="lookbook-side">
        <!-- PRODUITS SECONDAIRES DU VENDEUR -->
        <% if (produits[4]) { %>
          <img src="<%= produits[4].imagesGallery && produits[4].imagesGallery[0] ? produits[4].imagesGallery[0].url : produits[4].image %>" 
               alt="<%= produits[4].nom %>" 
               class="lookbook-side-product"
               onclick="window.location.href='/boutique/produit/<%= produits[4]._id %>'">
        <% } %>
        
        <% if (produits[5]) { %>
          <img src="<%= produits[5].imagesGallery && produits[5].imagesGallery[0] ? produits[5].imagesGallery[0].url : produits[5].image %>" 
               alt="<%= produits[5].nom %>" 
               class="lookbook-side-product"
               onclick="window.location.href='/boutique/produit/<%= produits[5]._id %>'">
        <% } %>
      </div>
    </div>
  </section>

  <!-- Produits Éditoriaux -->
  <section class="editorial-products" id="editorial">
    <% produits.slice(0, 2).forEach((produit, index) => { %>
      <div class="editorial-grid" style="<%= index % 2 === 1 ? 'direction: rtl;' : '' %>">
        <div>
          <img src="<%= produit.imagesGallery && produit.imagesGallery[0] ? produit.imagesGallery[0].url : produit.image %>" 
               alt="<%= produit.nom %>" 
               class="editorial-image"
               onclick="window.location.href='/boutique/produit/<%= produit._id %>'">
        </div>
        <div class="editorial-content" style="<%= index % 2 === 1 ? 'direction: ltr;' : '' %>">
          <h3 class="editorial-product-name"><%= produit.nom %></h3>
          <p class="editorial-product-description"><%= produit.description || 'Pièce signature alliant excellence artisanale et design contemporain. Matières nobles et finitions impeccables.' %></p>
          <p class="editorial-product-price"><%= produit.prix %> <%= produit.devise %></p>
          <div class="editorial-actions">
            <a href="/boutique/produit/<%= produit._id %>" class="editorial-btn editorial-btn-primary">Découvrir</a>
            <button class="editorial-btn editorial-btn-outline add-to-cart-editorial"
                    data-product-id="<%= produit._id %>"
                    data-product-name="<%= produit.nom %>"
                    data-product-price="<%= produit.prix %>">
              Ajouter au panier
            </button>
          </div>
        </div>
      </div>
    <% }); %>
  </section>

  <!-- Footer -->
  <footer>
    <div class="footer-content">
      <div class="footer-column">
        <h3><%= boutique.nom %></h3>
        <p style="color: rgba(255,255,255,0.7); font-size: 0.75rem; font-weight: 300; letter-spacing: 1px; line-height: 1.5; margin-bottom: 1.5rem;">
          <%= boutique.description %>
        </p>
        <div class="social-links">
          <a href="#" class="social-link"><i class="fab fa-instagram"></i></a>
          <a href="#" class="social-link"><i class="fab fa-pinterest"></i></a>
          <a href="#" class="social-link"><i class="fab fa-tiktok"></i></a>
        </div>
      </div>
      
      <div class="footer-column">
        <h3>BOUTIQUE</h3>
        <ul class="footer-links">
          <li><a href="#collection">Nouveautés</a></li>
          <li><a href="#lookbook">Collections</a></li>
          <li><a href="#editorial">Éditorial</a></li>
          <li><a href="#">Lookbook</a></li>
        </ul>
      </div>
      
      <div class="footer-column">
        <h3>SERVICE CLIENT</h3>
        <ul class="footer-links">
          <li><a href="#">Contact</a></li>
          <li><a href="#">Livraison</a></li>
          <li><a href="#">Retours</a></li>
          <li><a href="#">Guide des tailles</a></li>
        </ul>
      </div>
      
      <div class="footer-column">
        <h3>INFORMATIONS</h3>
        <ul class="footer-links">
          <li><a href="#">À propos</a></li>
          <li><a href="#">Carrières</a></li>
          <li><a href="#">Développement durable</a></li>
          <li><a href="#">Presse</a></li>
        </ul>
      </div>
    </div>
    
    <div class="footer-bottom">
      <p>&copy; 2024 <%= boutique.nom %>. TOUS DROITS RÉSERVÉS | MENTIONS LÉGALES | POLITIQUE DE CONFIDENTIALITÉ</p>
    </div>
  </footer>

  <script>
    // Gestion du menu mobile
    const menuToggle = document.getElementById('menuToggle');
    const navLinks = document.getElementById('navLinks');

    if (menuToggle && navLinks) {
      menuToggle.addEventListener('click', function() {
        navLinks.classList.toggle('active');
        menuToggle.innerHTML = navLinks.classList.contains('active') ? 
          '<i class="fas fa-times"></i>' : '<i class="fas fa-bars"></i>';
      });

      // Fermer le menu en cliquant sur un lien
      navLinks.querySelectorAll('a').forEach(link => {
        link.addEventListener('click', () => {
          navLinks.classList.remove('active');
          menuToggle.innerHTML = '<i class="fas fa-bars"></i>';
        });
      });
    }

    // Fonction pour créer les étoiles scintillantes
    function createStars() {
      const starsContainer = document.createElement('div');
      starsContainer.id = 'starsContainer';
      starsContainer.style.cssText = `
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        pointer-events: none;
        z-index: 1;
      `;
      document.body.appendChild(starsContainer);

      const starCount = window.innerWidth < 768 ? 80 : 150;
     
      for (let i = 0; i < starCount; i++) {
        const star = document.createElement('div');
        star.className = 'star';
       
        const left = Math.random() * 100;
        const top = Math.random() * 100;
        const size = Math.random() * 2;
        const delay = Math.random() * 3;
       
        star.style.cssText = `
          position: absolute;
          left: ${left}%;
          top: ${top}%;
          width: ${size}px;
          height: ${size}px;
          background: white;
          border-radius: 50%;
          animation: twinkle ${3 + Math.random() * 2}s infinite;
          animation-delay: ${delay}s;
          opacity: ${0.3 + Math.random() * 0.7};
        `;
       
        starsContainer.appendChild(star);
      }

      const style = document.createElement('style');
      style.textContent = `
        @keyframes twinkle {
          0%, 100% { opacity: 0.3; }
          50% { opacity: 1; }
        }
      `;
      document.head.appendChild(style);
    }

    // Fonction pour créer les particules cosmiques
    function createCosmicParticles() {
      const particlesContainer = document.createElement('div');
      particlesContainer.id = 'cosmicParticles';
      particlesContainer.style.cssText = `
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        pointer-events: none;
        z-index: 1;
      `;
      document.body.appendChild(particlesContainer);

      const particleCount = window.innerWidth < 768 ? 10 : 20;
     
      for (let i = 0; i < particleCount; i++) {
        const particle = document.createElement('div');
        particle.className = 'cosmic-particle';
       
        const startX = Math.random() * 100;
        const startY = Math.random() * 100;
        const delay = Math.random() * 8;
        const duration = 6 + Math.random() * 4;
        const size = 1 + Math.random() * 3;
       
        particle.style.cssText = `
          position: absolute;
          left: ${startX}%;
          top: ${startY}%;
          width: ${size}px;
          height: ${size}px;
          background: var(--lv-gold);
          border-radius: 50%;
          animation: float ${duration}s linear infinite;
          animation-delay: ${delay}s;
          opacity: ${0.1 + Math.random() * 0.3};
        `;
       
        particlesContainer.appendChild(particle);
      }

      const style = document.createElement('style');
      style.textContent = `
        @keyframes float {
          0% {
            transform: translate(0, 0) rotate(0deg);
            opacity: 0;
          }
          10% {
            opacity: 1;
          }
          90% {
            opacity: 1;
          }
          100% {
            transform: translate(${Math.random() * 100 - 50}px, ${Math.random() * 100 - 50}px) rotate(360deg);
            opacity: 0;
          }
        }
      `;
      document.head.appendChild(style);
    }

    // Fonction pour afficher la notification
    function showNotification(productName, productPrice) {
      const notification = document.getElementById('cartNotification');
      const message = document.getElementById('notificationMessage');
      
      message.textContent = `${productName} - ${productPrice} a été ajouté à votre panier`;
      notification.classList.add('show');
      
      setTimeout(() => {
        notification.classList.remove('show');
      }, 5000);
    }

    // Fonction pour mettre à jour le badge du panier
    function updateCartBadge(count) {
      let badge = document.getElementById('cartBadge');
      const cartIcon = document.querySelector('.fa-shopping-bag').parentElement;
      
      if (!badge) {
        badge = document.createElement('span');
        badge.id = 'cartBadge';
        badge.className = 'cart-badge';
        cartIcon.appendChild(badge);
      }
      
      badge.textContent = count;
      
      badge.style.animation = 'none';
      setTimeout(() => {
        badge.style.animation = 'pulse 0.5s ease-in-out';
      }, 10);
    }

    // Fonction principale d'ajout au panier
    async function addToCart(productId, productName, productPrice, button) {
      try {
        button.disabled = true;
        const originalText = button.textContent;
        button.textContent = 'AJOUT EN COURS...';

        const response = await fetch('/panier/ajouter/' + productId, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'X-Requested-With': 'XMLHttpRequest'
          },
          body: JSON.stringify({
            quantite: 1
          })
        });

        const data = await response.json();

        if (data.success) {
          showNotification(productName, productPrice + ' €');
          updateCartBadge(data.panierCount);
          
          button.textContent = '✓ AJOUTÉ !';
          button.style.background = '#28a745';
          button.style.borderColor = '#28a745';
          
          setTimeout(() => {
            button.disabled = false;
            button.textContent = originalText;
            button.style.background = '';
            button.style.borderColor = '';
          }, 2000);
        } else {
          throw new Error(data.message || 'Erreur lors de l\'ajout au panier');
        }
      } catch (error) {
        console.error('Erreur:', error);
        
        button.disabled = false;
        button.textContent = 'AJOUTER AU PANIER';
        
        alert('Erreur: ' + error.message);
      }
    }

    // Initialisation quand le DOM est chargé
    document.addEventListener('DOMContentLoaded', function() {
      console.log('DOM chargé - Initialisation des fonctionnalités panier');
      
      // Créer les animations de fond
      createStars();
      createCosmicParticles();

      // Gestion des boutons "Ajouter au panier" horizontaux
      document.querySelectorAll('.add-to-cart-horizontal').forEach(button => {
        button.addEventListener('click', function(e) {
          e.preventDefault();
          e.stopPropagation();
          
          const productId = this.getAttribute('data-product-id');
          const productName = this.getAttribute('data-product-name');
          const productPrice = this.getAttribute('data-product-price');
          
          console.log('Ajout au panier - Horizontal:', productId, productName, productPrice);
          addToCart(productId, productName, productPrice, this);
        });
      });

      // Gestion des boutons "Ajouter au panier" éditoriaux
      document.querySelectorAll('.add-to-cart-editorial').forEach(button => {
        button.addEventListener('click', function(e) {
          e.preventDefault();
          e.stopPropagation();
          
          const productId = this.getAttribute('data-product-id');
          const productName = this.getAttribute('data-product-name');
          const productPrice = this.getAttribute('data-product-price');
          
          console.log('Ajout au panier - Éditorial:', productId, productName, productPrice);
          addToCart(productId, productName, productPrice, this);
        });
      });

      // Smooth scroll pour les ancres
      document.querySelectorAll('a[href^="#"]').forEach(anchor => {
        anchor.addEventListener('click', function (e) {
          e.preventDefault();
          const target = document.querySelector(this.getAttribute('href'));
          if (target) {
            target.scrollIntoView({
              behavior: 'smooth',
              block: 'start'
            });
          }
        });
      });

      // Effet de parallaxe sur le défilement (désactivé sur mobile pour les performances)
      if (window.innerWidth > 768) {
        window.addEventListener('scroll', function() {
          const scrolled = window.pageYOffset;
          const stars = document.getElementById('starsContainer');
          const particles = document.getElementById('cosmicParticles');
         
          if (stars) {
            stars.style.transform = `translateY(${scrolled * 0.5}px)`;
          }
          if (particles) {
            particles.style.transform = `translateY(${scrolled * 0.3}px)`;
          }
        });
      }

      // Réinitialiser les animations lors du redimensionnement
      window.addEventListener('resize', function() {
        const starsContainer = document.getElementById('starsContainer');
        const particlesContainer = document.getElementById('cosmicParticles');
        
        if (starsContainer) starsContainer.remove();
        if (particlesContainer) particlesContainer.remove();
        
        createStars();
        createCosmicParticles();
      });

      // Debug: Vérifier que les boutons sont bien attachés
      console.log('Boutons horizontaux attachés:', document.querySelectorAll('.add-to-cart-horizontal').length);
      console.log('Boutons éditoriaux attachés:', document.querySelectorAll('.add-to-cart-editorial').length);
    });

    // Gestion des erreurs globales
    window.addEventListener('error', function(e) {
      console.error('Erreur globale:', e.error);
    });
  </script>
</body>
</html>