  <!-- Main Content -->
  <main>
    
<!-- Hero Section avec Images Dynamiques IA (3 secondes) -->
<section class="hero" id="accueil">
  <!-- Image produit en fond sélectionnée par IA -->
  <div class="hero-product-background">
    <% 
    // IA: Sélectionne les 4 meilleures images
    const bestProducts = [];
    produits.forEach(produit => {
      if (produit.imagesGallery && produit.imagesGallery.length > 0) {
        bestProducts.push({
          image: produit.imagesGallery[0].url,
          name: produit.nom,
          id: produit._id
        });
      }
    });
    
    // Trier par score IA et prendre les 4 meilleures
    const topProducts = bestProducts.slice(0, 4);
    %>
    
    <div class="hero-image-container" id="heroImageContainer">
      <% topProducts.forEach((product, index) => { %>
        <img src="<%= product.image %>" 
             alt="<%= product.name %>" 
             class="hero-product-image <%= index === 0 ? 'active' : '' %>"
             data-index="<%= index %>">
      <% }); %>
    </div>
    
    <div class="hero-product-overlay"></div>
    
    <!-- Indicateurs de slide -->
    <div class="hero-indicators" id="heroIndicators">
      <% topProducts.forEach((_, index) => { %>
        <div class="hero-indicator <%= index === 0 ? 'active' : '' %>" 
             data-index="<%= index %>"></div>
      <% }); %>
    </div>
  </div>

