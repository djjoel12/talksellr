    /* ========== PRODUITS GRID - RESPONSIVE ADAPTATIF AMÉLIORÉ ========== */
    .produits-grid {
      display: grid;
      gap: 1rem;
      margin-top: 1rem;
    }

    /* Mobile très petit: 1 colonne (pour écrans < 320px) */
    @media (max-width: 319px) {
      .produits-grid {
        grid-template-columns: 1fr;
      }
    }

    /* Mobile: 2 colonnes (écrans ≥ 320px) */
    .produits-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    /* Tablettes petites: 3 colonnes (écrans ≥ 480px) */
    @media (min-width: 480px) {
      .produits-grid {
        grid-template-columns: repeat(3, 1fr);
        gap: 1.2rem;
      }
    }

    /* Tablettes: 3 colonnes (écrans ≥ 768px) */
    @media (min-width: 768px) {
      .produits-grid {
        grid-template-columns: repeat(3, 1fr);
        gap: 1.5rem;
      }
    }

    /* Desktop: 4 colonnes (écrans ≥ 1024px) */
    @media (min-width: 1024px) {
      .produits-grid {
        grid-template-columns: repeat(4, 1fr);
        gap: 2rem;
      }
    }

    /* Grands écrans: 5 colonnes (écrans ≥ 1440px) */
    @media (min-width: 1440px) {
      .produits-grid {
        grid-template-columns: repeat(5, 1fr);
      }
    }
   
    .produit-card {
