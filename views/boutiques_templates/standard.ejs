    // Fonction pour initialiser le carousel automatique
    function initAutoScroll() {
      const scrollContainer = document.getElementById('horizontalScroll');
      const productCards = document.querySelectorAll('.product-card-horizontal');
      const dotsContainer = document.getElementById('carouselDots');
      
      if (!scrollContainer || productCards.length === 0) return;

      // Créer les points indicateurs
      dotsContainer.innerHTML = '';
      for (let i = 0; i < productCards.length; i++) {
        const dot = document.createElement('div');
        dot.className = `carousel-dot ${i === 0 ? 'active' : ''}`;
        dot.addEventListener('click', () => scrollToIndex(i));
        dotsContainer.appendChild(dot);
      }

      // Gérer le défilement manuel
      scrollContainer.addEventListener('scroll', () => {
        updateHorizontalScrollProgress();
        updateActiveDot();
      });

      // Contrôles précédent/suivant
      document.getElementById('carouselPrev').addEventListener('click', scrollToPrev);
      document.getElementById('carouselNext').addEventListener('click', scrollToNext);

      // Démarrer le défilement automatique
      startAutoScroll();
    }

    // Fonction pour faire défiler vers un index spécifique
    function scrollToIndex(index) {
      const scrollContainer = document.getElementById('horizontalScroll');
      const productCards = document.querySelectorAll('.product-card-horizontal');
      
      if (index >= 0 && index < productCards.length) {
        const card = productCards[index];
        const scrollPosition = card.offsetLeft - scrollContainer.offsetLeft;
        
        scrollContainer.scrollTo({
          left: scrollPosition,
          behavior: 'smooth'
        });
        
        currentScrollIndex = index;
        updateActiveDot();
        
        // Redémarrer le défilement automatique après une interaction manuelle
        restartAutoScroll();
      }
    }

    // Fonction pour défiler vers l'élément précédent
    function scrollToPrev() {
      const productCards = document.querySelectorAll('.product-card-horizontal');
      let newIndex = currentScrollIndex - 1;
      if (newIndex < 0) newIndex = productCards.length - 1;
      scrollToIndex(newIndex);
    }

    // Fonction pour défiler vers l'élément suivant
    function scrollToNext() {
      const productCards = document.querySelectorAll('.product-card-horizontal');
      let newIndex = currentScrollIndex + 1;
      if (newIndex >= productCards.length) newIndex = 0;
      scrollToIndex(newIndex);
    }

    // Fonction pour mettre à jour le point actif
    function updateActiveDot() {
      const scrollContainer = document.getElementById('horizontalScroll');
      const productCards = document.querySelectorAll('.product-card-horizontal');
      const dots = document.querySelectorAll('.carousel-dot');
      
      if (productCards.length === 0) return;

      // Trouver l'élément le plus visible
      let mostVisibleIndex = 0;
      let maxVisibility = 0;

      productCards.forEach((card, index) => {
        const rect = card.getBoundingClientRect();
        const containerRect = scrollContainer.getBoundingClientRect();
        
        // Calculer la surface visible
        const visibleLeft = Math.max(rect.left, containerRect.left);
        const visibleRight = Math.min(rect.right, containerRect.right);
        const visibleWidth = Math.max(0, visibleRight - visibleLeft);
        const visibility = visibleWidth / rect.width;

        if (visibility > maxVisibility) {
          maxVisibility = visibility;
          mostVisibleIndex = index;
        }
      });

      currentScrollIndex = mostVisibleIndex;

      // Mettre à jour les points
      dots.forEach((dot, index) => {
        dot.classList.toggle('active', index === currentScrollIndex);
      });
    }

    // Fonction pour démarrer le défilement automatique
    function startAutoScroll() {
      autoScrollInterval = setInterval(() => {
        scrollToNext();
      }, scrollDuration);
    }

    // Fonction pour arrêter le défilement automatique
    function stopAutoScroll() {
      if (autoScrollInterval) {
        clearInterval(autoScrollInterval);
      }
    }

    // Fonction pour redémarrer le défilement automatique
    function restartAutoScroll() {
      stopAutoScroll();
      startAutoScroll();
    }

