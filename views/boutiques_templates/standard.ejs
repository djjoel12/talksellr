    /* AMÉLIORATION DES BOUTONS - BIEN VISIBLES */
    .produit-actions {
      display: flex;
      gap: 0.6rem;
      flex-direction: column;
    }

    /* Adaptation des boutons pour mobile */
    @media (max-width: 319px) {
