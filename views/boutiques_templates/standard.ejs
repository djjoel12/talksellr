// ========== FONCTIONS POUR LE HERO DYNAMIQUE (3 secondes) ==========
let currentHeroIndex = 0;
let heroInterval;
const heroChangeTime = 3000; // 3 secondes

function initHeroSlider() {
  const images = document.querySelectorAll('.hero-product-image');
  const indicators = document.querySelectorAll('.hero-indicator');
  
  if (images.length === 0) return;

  // Démarrer l'intervalle
  startHeroInterval();

  // Gérer le clic sur les indicateurs
  indicators.forEach((indicator, index) => {
    indicator.addEventListener('click', () => {
      goToHeroSlide(index);
    });
  });

  // Pause au survol
  const heroSection = document.querySelector('.hero');
  heroSection.addEventListener('mouseenter', stopHeroInterval);
  heroSection.addEventListener('mouseleave', startHeroInterval);
}

function startHeroInterval() {
  stopHeroInterval();
  heroInterval = setInterval(() => {
    nextHeroSlide();
  }, heroChangeTime);
}

function stopHeroInterval() {
  if (heroInterval) {
    clearInterval(heroInterval);
  }
}

function nextHeroSlide() {
  const images = document.querySelectorAll('.hero-product-image');
  const indicators = document.querySelectorAll('.hero-indicator');
  
  currentHeroIndex = (currentHeroIndex + 1) % images.length;
  updateHeroSlide(currentHeroIndex);
}

function goToHeroSlide(index) {
  currentHeroIndex = index;
  updateHeroSlide(currentHeroIndex);
  startHeroInterval(); // Redémarrer l'intervalle après interaction manuelle
}

function updateHeroSlide(index) {
  const images = document.querySelectorAll('.hero-product-image');
  const indicators = document.querySelectorAll('.hero-indicator');
  
  // Mettre à jour les images
  images.forEach((img, i) => {
    img.classList.toggle('active', i === index);
  });
  
  // Mettre à jour les indicateurs
  indicators.forEach((indicator, i) => {
    indicator.classList.toggle('active', i === index);
  });
}
