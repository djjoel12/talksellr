    }
   
    .footer-links a {
      color: var(--zara-dark-gray);
      transition: all 0.3s ease;
      font-size: 0.7rem;
      font-weight: 300;
      letter-spacing: 0.8px;
      text-transform: uppercase;
      text-decoration: none;
    }
   
    .footer-links a:hover {
      color: var(--zara-black);
      padding-left: 2px;
    }
   
    .social-links {
      display: flex;
      gap: 0.6rem;
      margin-top: 1.2rem;
    }
   
    .social-link {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 30px;
      height: 30px;
      background: var(--zara-light-gray);
      color: var(--zara-black);
      border-radius: 0;
      transition: all 0.3s ease;
      font-size: 0.8rem;
      text-decoration: none;
    }
   
    .social-link:hover {
      background: var(--zara-black);
      color: var(--zara-white);
      transform: translateY(-1px);
    }
   
    .footer-bottom {
      text-align: center;
      padding-top: 1.2rem;
      border-top: 1px solid var(--zara-border);
      color: var(--zara-dark-gray);
      font-size: 0.65rem;
      font-weight: 300;
      letter-spacing: 1px;
      text-transform: uppercase;
      line-height: 1.3;
    }
   
    /* Loading Animation */
    .loading {
      opacity: 0;
      transform: translateY(15px);
      animation: fadeInUp 0.6s ease forwards;
    }
   
    @keyframes fadeInUp {
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
   
    /* Media Queries pour les tablettes */
    @media (min-width: 768px) {
      .header-container {
        padding: 0 1.2rem;
        flex-wrap: nowrap;
      }
     
      .logo {
        font-size: 1.4rem;
        order: 1;
        flex: none;
      }
     
      .nav-links {
        display: flex;
        position: static;
        flex-direction: row;
        gap: 1.5rem;
        background: none;
        border: none;
        padding: 0;
        order: 2;
        flex: 1;
        justify-content: center;
      }
     
      .nav-links a {
        font-size: 0.75rem;
        padding: 0;
      }
     
      .header-actions {
        order: 3;
        gap: 0.8rem;
      }
     
      .mobile-menu-btn {
        display: none;
      }
     
      .search-bar {
        display: flex;
        position: static;
        background: none;
        padding: 0;
        border: none;
      }
     
      .search-bar input {
        width: 150px;
        padding: 0.4rem 0;
      }
     
      .mobile-search-btn {
        display: none;
      }
     
      .hero {
        padding: 4rem 0 3rem;
        min-height: 70vh;
      }
     
      .hero h1 {
        font-size: 2.5rem;
        letter-spacing: 3px;
      }
     
      .hero p {
        font-size: 1.1rem;
      }
     
      .cta-button {
        padding: 1.1rem 2.5rem;
        font-size: 0.8rem;
      }
     
      .section {
        padding: 3rem 0;
      }
     
      .section-title {
        font-size: 1.6rem;
      }
     
      .carousel-controls {
        margin-top: 1.2rem;
      }

      /* Responsive pour les catégories */
      .categories-nav {
        gap: 0.8rem;
      }
      
      .category-tab {
        flex: none;
        min-width: auto;
      }

      /* Section horizontale tablette */
      .collection-horizontal {
        padding: 2.5rem 0;
      }

      .product-card-horizontal {
        min-width: min(40vw, 220px);
      }

      .product-image {
        height: 160px;
      }

      .product-actions {
        flex-direction: row;
      }

      .product-btn {
        font-size: 0.65rem;
        padding: 0.6rem 0.7rem;
        min-height: 34px;
      }
    }
   
    /* Media Queries pour les desktop */
    @media (min-width: 1024px) {
      .header-container {
        padding: 0 1.5rem;
      }
     
      .logo {
        font-size: 1.6rem;
      }
     
      .nav-links {
        gap: 2rem;
      }
     
      .search-bar input {
        width: 180px;
      }
     
      .hero {
        padding: 5rem 0 4rem;
        min-height: 80vh;
      }
     
      .hero h1 {
        font-size: 3.5rem;
        letter-spacing: 4px;
      }
     
      .hero p {
        font-size: 1.2rem;
      }
     
      .cta-button {
        padding: 1.2rem 3rem;
      }
     
      .section {
        padding: 4rem 0;
      }
     
      .section-title {
        font-size: 1.8rem;
      }

      /* Section horizontale desktop */
      .product-card-horizontal {
        min-width: 250px;
      }

      .product-image {
        height: 180px;
      }
    }
   
    /* Support pour l'orientation paysage sur mobile */
    @media (max-height: 500px) and (orientation: landscape) {
      .hero {
        min-height: 100vh;
        padding: 2rem 0;
      }
     
      .hero h1 {
        font-size: 1.6rem;
        margin-bottom: 0.4rem;
      }
     
      .hero p {
        font-size: 0.8rem;
        margin-bottom: 1.2rem;
      }
     
      .cta-button {
        padding: 0.7rem 1.5rem;
        font-size: 0.7rem;
      }
    }
   
    /* Support pour les appareils avec notch */
    @supports(padding: max(0px)) {
      .header-container,
      .container {
        padding-left: max(0.8rem, env(safe-area-inset-left));
        padding-right: max(0.8rem, env(safe-area-inset-right));
      }
     
      .hero {
        padding-top: max(3rem, env(safe-area-inset-top));
      }
     
      footer {
        padding-bottom: max(1rem, env(safe-area-inset-bottom));
      }
    }
   
    /* Améliorations pour le tactile */
    @media (hover: none) and (pointer: coarse) {
      .produit-card:hover {
        transform: none;
        box-shadow: none;
      }
     
      .produit-card:active {
        transform: scale(0.98);
      }
     
      .btn:active,
      .cta-button:active {
        transform: scale(0.95);
      }
     
      .thumbnail:hover {
        transform: none;
      }
     
      .thumbnail:active {
        transform: scale(1.1);
      }
     
      .product-card-horizontal:hover {
        transform: none;
      }

      .category-tab:hover {
        transform: none;
        box-shadow: none;
      }
    }
   
    /* Optimisations pour les écrans très petits */
    @media (max-width: 319px) {
      .header-container {
        padding: 0 0.6rem;
      }
     
      .logo {
        font-size: 1rem;
        letter-spacing: 1px;
      }
     
      .icon-btn {
        padding: 0.2rem;
        font-size: 0.9rem;
      }
     
      .cart-icon-link {
        padding: 0.2rem;
      }
     
      .hero h1 {
        font-size: 1.5rem;
        letter-spacing: 1.5px;
      }
     
      .hero p {
        font-size: 0.8rem;
        letter-spacing: 1px;
      }
     
      .cta-button {
        padding: 0.8rem 1.5rem;
        font-size: 0.7rem;
      }

      .carousel-btn {
        width: 28px;
        height: 28px;
        font-size: 0.55rem;
      }

      /* Responsive pour les catégories sur très petits écrans */
      .categories-nav {
        gap: 0.3rem;
        padding: 0 0.4rem;
      }
      
      .category-tab {
        padding: 0.5rem 0.6rem;
        font-size: 0.65rem;
        min-width: calc(50% - 0.3rem);
      }
      
      .category-icon {
        font-size: 0.7rem;
      }

      /* Section horizontale très petits écrans */
      .product-card-horizontal {
        min-width: 40vw;
      }

      .product-image {
        height: 120px;
      }

      .product-info {
        padding: 0.6rem;
      }

      .product-name {
        font-size: 0.7rem;
      }

      .product-price {
        font-size: 0.75rem;
      }

      .product-btn {
        font-size: 0.55rem;
        padding: 0.4rem 0.5rem;
        min-height: 28px;
      }
    }

    /* Responsive pour la section horizontale */
    @media (max-width: 768px) {
      .collection-horizontal {
        padding: 1.5rem 0;
      }

      .collection-header {
        margin-bottom: 1rem;
      }

      .scroll-container {
        padding: 0 0.4rem;
      }

      .horizontal-scroll {
        gap: 0.6rem;
        padding: 0.4rem 0;
      }
    }

    @media (min-width: 1024px) {
      .product-card-horizontal {
        min-width: 280px;
      }

      .product-image {
        height: 200px;
      }
    }

    /* Responsive pour les catégories */
    @media (max-width: 768px) {
      .categories-nav {
        gap: 0.4rem;
        padding: 0 0.4rem;
      }
      
      .category-tab {
        padding: 0.5rem 0.7rem;
        font-size: 0.7rem;
        flex: 1;
        min-width: calc(50% - 0.4rem);
        justify-content: center;
      }
      
      .category-icon {
        font-size: 0.8rem;
      }
      
      .category-title {
        font-size: 1.1rem;
        flex-direction: column;
        gap: 0.4rem;
      }
    }

    @media (max-width: 480px) {
      .category-tab {
        min-width: calc(50% - 0.4rem);
      }
    }

    @media (max-width: 360px) {
      .category-tab {
        min-width: 100%;
      }
    }
  </style>
</head>
<body>
  <!-- Le reste du code HTML reste exactement le même -->
  <!-- Notification Panier -->
  <div id="cartNotification" class="cart-notification">
    <div class="notification-content">
      <div class="notification-icon"></div>
