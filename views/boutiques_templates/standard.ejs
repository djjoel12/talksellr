    /* Footer Premium - Optimisé Mobile */
    footer {
      background: var(--zara-white);
      border-top: 1px solid var(--zara-border);
      padding: 2rem 0 1rem;
      margin-top: auto;
    }
   
    .footer-content {
      display: grid;
      grid-template-columns: 1fr;
      gap: 1.5rem;
      margin-bottom: 1.5rem;
    }

    /* Adaptation du footer */
    @media (min-width: 480px) {
      .footer-content {
