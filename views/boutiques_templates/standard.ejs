<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= boutique.nom %> - Collection Exclusive</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
    :root {
      --zara-black: #000000;
      --zara-white: #ffffff;
      --zara-light-gray: #f5f5f5;
      --zara-medium-gray: #e5e5e5;
      --zara-dark-gray: #666666;
      --zara-text: #1a1a1a;
      --zara-border: #ddd;
      --zara-accent: #1a1a1a;
      --success-color: #000000;
      
      /* Variables pour la section horizontale */
      --lv-dark: #000000;
      --lv-gold: #C9A96E;
      --lv-beige: #F5F5F0;
      --lv-white: #FFFFFF;
      --lv-light-gray: #F8F8F8;
      --lv-text: #1A1A1A;
      --lv-border: #DDDDDD;
      --transition-luxe: cubic-bezier(0.25, 0.46, 0.45, 0.94);
    }
   
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }
   
    body {
      font-family: 'Helvetica Neue', Arial, sans-serif;
      color: var(--zara-text);
      background: var(--zara-white);
      line-height: 1.5;
      font-weight: 300;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      overflow-x: hidden;
    }
/* Hero Section avec Images Dynamiques IA */
.hero-product-background {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 1;
}

.hero-image-container {
  position: relative;
  width: 100%;
  height: 100%;
}

.hero-product-image {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
  opacity: 0;
  transition: opacity 1s ease-in-out;
}

.hero-product-image.active {
  opacity: 1;
}

.hero-product-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(45deg, rgba(0,0,0,0.7), rgba(0,0,0,0.4));
  z-index: 2;
}

.hero-indicators {
  position: absolute;
  bottom: 20px;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  gap: 8px;
  z-index: 3;
}

.hero-indicator {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: rgba(255,255,255,0.4);
  cursor: pointer;
  transition: all 0.3s ease;
}

.hero-indicator.active {
  background: #ffffff;
  transform: scale(1.2);
}
    /* ========== SECTION COLLECTION HORIZONTALE (Style Louis Vuitton) ========== */
    .collection-horizontal {
      padding: 2rem 0;
      background: var(--lv-beige);
      position: relative;
    }

    .collection-header {
      text-align: center;
      margin-bottom: 1.5rem;
      padding: 0 1rem;
    }

    .collection-title {
      font-size: clamp(1.3rem, 4vw, 1.8rem);
      font-weight: 300;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      margin-bottom: 0.5rem;
      color: var(--lv-dark);
    }

    .collection-subtitle {
      font-size: clamp(0.75rem, 2vw, 0.85rem);
      font-weight: 300;
      letter-spacing: 1px;
      color: var(--lv-text);
      opacity: 0.7;
      max-width: 90%;
      margin: 0 auto;
      line-height: 1.4;
    }

    /* Barre de défilement horizontale */
    .scroll-container {
      position: relative;
      padding: 0 0.5rem;
    }

    /* Indicateur de défilement en bas */
    .scroll-indicator-bottom {
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 0.8rem;
      margin-top: 1rem;
      padding: 0 0.5rem;
    }

    .scroll-progress {
      flex: 1;
      max-width: 150px;
      height: 2px;
      background: var(--lv-border);
      border-radius: 2px;
      position: relative;
      overflow: hidden;
    }

    .scroll-progress-bar {
      position: absolute;
      left: 0;
      top: 0;
      height: 100%;
      background: var(--lv-dark);
      width: 0%;
      transition: width 0.3s ease;
    }

    .scroll-text-bottom {
      font-size: 0.65rem;
      font-weight: 300;
      letter-spacing: 0.8px;
      color: var(--lv-dark);
      text-transform: uppercase;
      white-space: nowrap;
    }

    .horizontal-scroll {
      display: flex;
      overflow-x: auto;
      gap: 0.8rem;
      padding: 0.5rem 0;
      scrollbar-width: none;
      -ms-overflow-style: none;
      scroll-behavior: smooth;
      scroll-padding: 0 0.5rem;
      cursor: grab;
    }

    .horizontal-scroll:active {
      cursor: grabbing;
    }

    .horizontal-scroll::-webkit-scrollbar {
      display: none;
    }

    /* Cartes produits réduites - OPTIMISÉ POUR PETITS ÉCRANS */
    .product-card-horizontal {
      min-width: min(45vw, 200px);
      background: var(--lv-white);
      position: relative;
      transition: transform 0.3s ease;
      cursor: pointer;
      flex-shrink: 0;
      border-radius: 4px;
      overflow: hidden;
      border: 1px solid var(--lv-border);
    }

    .product-card-horizontal:hover {
      transform: translateY(-3px);
    }

    /* Images réduites pour petits écrans */
    .product-image {
      width: 100%;
      height: 140px;
      object-fit: cover;
      transition: transform 0.3s ease;
    }

    .product-card-horizontal:hover .product-image {
      transform: scale(1.05);
    }

    .product-info {
      padding: 0.8rem;
      background: var(--lv-white);
    }

    .product-name {
      font-size: 0.75rem;
      font-weight: 400;
      letter-spacing: 0.8px;
      text-transform: uppercase;
      margin-bottom: 0.3rem;
      line-height: 1.2;
      color: var(--lv-dark);
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    .product-price {
      font-size: 0.8rem;
      font-weight: 300;
      letter-spacing: 0.7px;
      margin-bottom: 0.6rem;
      color: var(--lv-dark);
    }

    .product-actions {
      display: flex;
      gap: 0.4rem;
      flex-direction: column;
    }

    .product-btn {
      padding: 0.5rem 0.6rem;
      border: 1px solid var(--lv-dark);
      background: transparent;
      color: var(--lv-dark);
      text-transform: uppercase;
      letter-spacing: 0.8px;
      font-size: 0.6rem;
      cursor: pointer;
      transition: all 0.3s ease;
      text-decoration: none;
      flex: 1;
      text-align: center;
      min-height: 30px;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 2px;
    }

    .product-btn-primary {
      background: var(--lv-dark);
      color: var(--lv-white);
    }

    .product-btn-primary:hover {
      background: var(--lv-gold);
      border-color: var(--lv-gold);
      color: var(--lv-dark);
    }

    .product-btn-outline:hover {
      background: var(--lv-dark);
      color: var(--lv-white);
    }

    /* Badge nouveau */
    .product-badge {
      position: absolute;
      top: 0.6rem;
      left: 0.6rem;
      background: var(--lv-dark);
      color: var(--lv-white);
      padding: 0.2rem 0.4rem;
      font-size: 0.55rem;
      font-weight: 400;
      letter-spacing: 0.6px;
      text-transform: uppercase;
      z-index: 2;
    }

    /* Contrôles de défilement automatique */
    .carousel-controls {
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 0.8rem;
      margin-top: 0.8rem;
    }

    .carousel-btn {
      background: var(--lv-dark);
      color: var(--lv-white);
      border: none;
      width: 32px;
      height: 32px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      transition: all 0.3s ease;
      font-size: 0.7rem;
    }

    .carousel-btn:hover {
      background: var(--lv-gold);
      transform: scale(1.1);
    }

    .carousel-indicator {
      display: flex;
      gap: 0.4rem;
    }

    .carousel-dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: var(--lv-border);
      cursor: pointer;
      transition: all 0.3s ease;
    }

    .carousel-dot.active {
      background: var(--lv-dark);
      transform: scale(1.2);
    }

    /* ========== STYLES POUR LA NAVIGATION PAR CATÉGORIES ========== */
    .categories-nav {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      justify-content: center;
      margin-bottom: 2rem;
      padding: 0 0.5rem;
    }

    .category-tab {
      display: flex;
      align-items: center;
      gap: 0.4rem;
      padding: 0.6rem 0.8rem;
      background: var(--zara-white);
      border: 1px solid var(--zara-border);
      color: var(--zara-dark-gray);
      font-size: 0.7rem;
      font-weight: 400;
      letter-spacing: 0.8px;
      text-transform: uppercase;
      cursor: pointer;
      transition: all 0.3s ease;
      border-radius: 20px;
      white-space: nowrap;
      flex: 1;
      min-width: calc(50% - 0.5rem);
      max-width: 200px;
      justify-content: center;
    }

    .category-tab:hover {
      border-color: var(--zara-black);
      color: var(--zara-black);
      transform: translateY(-2px);
      box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    }

    .category-tab.active {
      background: var(--zara-black);
      border-color: var(--zara-black);
      color: var(--zara-white);
    }

    .category-icon {
      font-size: 0.8rem;
    }

    .category-name {
      font-weight: 500;
    }

    .product-count {
      font-size: 0.6rem;
      opacity: 0.7;
      font-weight: 300;
    }

    /* Contenu des catégories */
    .categories-content {
      position: relative;
    }

    .category-content {
      display: none;
      animation: fadeInUp 0.6s ease;
    }

    .category-content.active {
      display: block;
    }

    .category-header {
      text-align: center;
      margin-bottom: 2rem;
      padding: 0 1rem;
    }

    .category-title {
      font-size: 1.2rem;
      font-weight: 300;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      margin-bottom: 0.6rem;
      color: var(--zara-black);
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.6rem;
    }

    .category-description {
      color: var(--zara-dark-gray);
      font-size: 0.8rem;
      font-weight: 300;
      letter-spacing: 0.8px;
      line-height: 1.4;
      max-width: 500px;
      margin: 0 auto;
    }

    .empty-category {
      text-align: center;
      padding: 2rem 1rem;
      background: var(--zara-light-gray);
      border-radius: 6px;
    }

    .empty-category i {
      font-size: 2rem;
      color: var(--zara-dark-gray);
      margin-bottom: 0.8rem;
      opacity: 0.5;
    }

    .empty-category h4 {
      font-size: 0.9rem;
      font-weight: 400;
      color: var(--zara-black);
      margin-bottom: 0.6rem;
      text-transform: uppercase;
      letter-spacing: 1.2px;
    }

    .empty-category p {
      color: var(--zara-dark-gray);
      font-size: 0.75rem;
      font-weight: 300;
      letter-spacing: 0.8px;
    }

    /* Animation pour le changement de catégorie */
    @keyframes fadeInUp {
      from {
        opacity: 0;
        transform: translateY(20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    /* CORRECTION : Icône panier toujours cliquable */
    .cart-icon-link {
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 0.4rem;
      color: var(--zara-black);
      text-decoration: none;
      opacity: 0.8;
      transition: opacity 0.3s ease;
    }

    .cart-icon-link:hover {
      opacity: 1;
    }

    /* Badge de notification WhatsApp-like */
    .cart-badge {
      position: absolute;
      top: -4px;
      right: -4px;
      background: #ff4444;
      color: white;
      border-radius: 50%;
      width: 16px;
      height: 16px;
      font-size: 0.6rem;
      font-weight: 600;
      display: flex;
      align-items: center;
      justify-content: center;
      animation: pulse 2s infinite;
      box-shadow: 0 1px 4px rgba(255, 68, 68, 0.4);
    }

    @keyframes pulse {
      0% { transform: scale(1); }
      50% { transform: scale(1.1); }
      100% { transform: scale(1); }
    }

    /* Header Premium - Version Mobile First */
    header {
      background: var(--zara-white);
      border-bottom: 1px solid var(--zara-border);
      padding: 0.6rem 0;
      position: sticky;
      top: 0;
      z-index: 1000;
      backdrop-filter: blur(10px);
    }
   
    .header-container {
      max-width: 1400px;
      margin: 0 auto;
      padding: 0 0.8rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
    }
   
    .logo {
      font-size: 1.2rem;
      font-weight: 300;
      letter-spacing: 1.5px;
      color: var(--zara-black);
      text-transform: uppercase;
      order: 1;
      flex: 1;
    }
   
    .nav-links {
      display: none;
      flex-direction: column;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background: var(--zara-white);
      border-bottom: 1px solid var(--zara-border);
      padding: 1rem;
      gap: 0.8rem;
      z-index: 999;
    }
   
    .nav-links.active {
      display: flex;
    }
   
    .nav-links a {
      font-weight: 300;
      font-size: 0.8rem;
      letter-spacing: 1px;
      text-transform: uppercase;
      transition: all 0.3s ease;
      opacity: 0.8;
      position: relative;
      padding: 0.4rem 0;
      text-decoration: none;
      color: var(--zara-black);
    }
   
    .nav-links a:hover {
      opacity: 1;
    }
   
    .nav-links a::after {
      content: '';
      position: absolute;
      bottom: 0;
      left: 0;
      width: 0;
      height: 1px;
      background: var(--zara-black);
      transition: width 0.3s ease;
    }
   
    .nav-links a:hover::after {
      width: 100%;
    }
   
    .header-actions {
      display: flex;
      gap: 0.6rem;
      align-items: center;
      order: 2;
    }
   
    .search-bar {
      display: none;
      align-items: center;
      position: relative;
    }
   
    .search-bar.active {
      display: flex;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background: var(--zara-white);
      padding: 0.8rem;
      border-bottom: 1px solid var(--zara-border);
      z-index: 1001;
    }
   
    .search-bar input {
      border: none;
      outline: none;
      background: transparent;
      color: var(--zara-black);
      padding: 0.6rem;
      width: 100%;
      font-size: 0.8rem;
      border-bottom: 1px solid var(--zara-border);
      transition: border-color 0.3s ease;
    }
   
    .search-bar input:focus {
      border-bottom-color: var(--zara-black);
    }
   
    .search-bar input::placeholder {
      color: var(--zara-dark-gray);
      font-weight: 300;
      letter-spacing: 0.8px;
    }
   
    .icon-btn {
      background: none;
      border: none;
      color: var(--zara-black);
      font-size: 1rem;
      cursor: pointer;
      transition: opacity 0.3s ease;
      opacity: 0.8;
      padding: 0.4rem;
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;
    }
   
    .icon-btn:hover {
      opacity: 1;
    }
   
    .mobile-menu-btn {
      display: block;
      order: 3;
    }
   
    .mobile-search-btn {
      display: block;
    }
   
    /* Hero Section - Optimisé Mobile */
    .hero {
      background: #000000;
      padding: 3rem 0 2rem;
      text-align: center;
      position: relative;
      overflow: hidden;
      min-height: 60vh;
      display: flex;
      align-items: center;
      justify-content: center;
      isolation: isolate;
    }
   
    /* Optimisation des animations pour mobile */
    .hero-grid {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background:
        linear-gradient(rgba(255,255,255,0.1) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255,255,255,0.1) 1px, transparent 1px);
      background-size: 25px 25px;
      animation: gridMove 20s linear infinite;
      opacity: 0.3;
      z-index: 1;
    }
    @keyframes gridMove {
      0% { transform: translate(0, 0); }
      100% { transform: translate(25px, 25px); }
    }
    .cosmic-particles {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      pointer-events: none;
      z-index: 2;
    }
    .cosmic-particle {
      position: absolute;
      background: radial-gradient(circle, #ffffff, transparent);
      border-radius: 50%;
      animation: cosmicFloat 8s ease-in-out infinite;
    }
    @keyframes cosmicFloat {
      0%, 100% {
        transform: translate(0, 0) scale(1);
        opacity: 0;
      }
      25% {
        opacity: 0.6;
      }
      50% {
        transform: translate(40px, -20px) scale(1.5);
        opacity: 0.3;
      }
      75% {
        opacity: 0.8;
      }
    }
    .stars {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      z-index: 1;
    }
    .star {
      position: absolute;
      background: white;
      border-radius: 50%;
      animation: twinkle 3s ease-in-out infinite;
    }
    @keyframes twinkle {
      0%, 100% { opacity: 0.2; transform: scale(0.8); }
      50% { opacity: 1; transform: scale(1.2); }
    }
    .light-beam {
      position: absolute;
      top: -50%;
      left: -25%;
      width: 150%;
      height: 200%;
      background: linear-gradient(
        45deg,
        transparent 0%,
        rgba(255,255,255,0.02) 25%,
        rgba(255,255,255,0.05) 50%,
        rgba(255,255,255,0.02) 75%,
        transparent 100%
      );
      transform: rotate(45deg);
      animation: beamSweep 15s ease-in-out infinite;
      z-index: 1;
    }
    @keyframes beamSweep {
      0%, 100% { transform: rotate(45deg) translateX(-100%); }
      50% { transform: rotate(45deg) translateX(100%); }
    }
    .hero-content {
      max-width: 800px;
      margin: 0 auto;
      padding: 0 1rem;
      position: relative;
      z-index: 3;
    }
    /* Titre optimisé mobile */
    .hero h1 {
      font-size: 1.8rem;
      font-weight: 300;
      margin-bottom: 0.8rem;
      letter-spacing: 2px;
      text-transform: uppercase;
      color: #ffffff;
      opacity: 0;
      transform: translateY(30px);
      animation: titleReveal 1.5s cubic-bezier(0.25, 0.46, 0.45, 0.94) 0.5s forwards;
      text-shadow: 0 0 20px rgba(255,255,255,0.5);
      position: relative;
      line-height: 1.2;
    }
    .hero h1::after {
      content: '';
      position: absolute;
      bottom: -6px;
      left: 50%;
      transform: translateX(-50%);
      width: 50px;
      height: 1px;
      background: linear-gradient(90deg, transparent, #ffffff, transparent);
      animation: lineReveal 2s ease-in-out 1.5s forwards;
      opacity: 0;
    }
    @keyframes lineReveal {
      0% { opacity: 0; width: 0; }
      100% { opacity: 1; width: 50px; }
    }
    @keyframes titleReveal {
      0% {
        opacity: 0;
        transform: translateY(30px) scale(0.9);
        text-shadow: 0 0 0 rgba(255,255,255,0);
      }
      50% {
        text-shadow: 0 0 30px rgba(255,255,255,0.8);
      }
      100% {
        opacity: 1;
        transform: translateY(0) scale(1);
        text-shadow: 0 0 20px rgba(255,255,255,0.5);
      }
    }
    /* Description optimisée mobile */
    .hero p {
      font-size: 0.9rem;
      margin-bottom: 1.5rem;
      font-weight: 300;
      letter-spacing: 1.2px;
      color: rgba(255,255,255,0.8);
      line-height: 1.5;
      opacity: 0;
      transform: translateY(20px);
      animation: subtitleReveal 1.2s cubic-bezier(0.25, 0.46, 0.45, 0.94) 1s forwards;
      padding: 0 0.5rem;
    }
    @keyframes subtitleReveal {
      0% {
        opacity: 0;
        transform: translateY(20px);
      }
      100% {
        opacity: 1;
        transform: translateY(0);
      }
    }
   
    /* Bouton CTA optimisé mobile */
    .cta-button {
      display: inline-block;
      background: transparent;
      color: #ffffff;
      padding: 1rem 2rem;
      font-weight: 400;
      font-size: 0.75rem;
      text-transform: uppercase;
      letter-spacing: 1.5px;
      transition: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
      border: 1px solid #ffffff;
      cursor: pointer;
      text-decoration: none;
      position: relative;
      overflow: hidden;
      opacity: 0;
      transform: translateY(30px) scale(0.8);
      animation: buttonReveal 1s cubic-bezier(0.25, 0.46, 0.45, 0.94) 1.5s forwards;
      border-radius: 2px;
    }
    @keyframes buttonReveal {
      0% {
        opacity: 0;
        transform: translateY(30px) scale(0.8);
      }
      70% {
        transform: translateY(-5px) scale(1.02);
      }
      100% {
        opacity: 1;
        transform: translateY(0) scale(1);
      }
    }
   
    .cta-button::before {
      content: '';
      position: absolute;
      top: 0;
      left: -100%;
      width: 100%;
      height: 100%;
      background: linear-gradient(90deg, transparent, rgba(255,255,255,0.2), transparent);
      transition: left 0.6s ease;
    }
   
    .cta-button:hover::before {
      left: 100%;
    }
    .cta-button::after {
      content: '';
      position: absolute;
      top: -1px;
      left: -1px;
      right: -1px;
      bottom: -1px;
      background: linear-gradient(45deg, #ffffff, #cccccc, #ffffff);
      z-index: -1;
      border-radius: inherit;
      opacity: 0;
      transition: opacity 0.3s ease;
    }
   
    .cta-button:hover::after {
      opacity: 1;
    }
   
    .cta-button span {
      position: relative;
      z-index: 1;
      display: inline-block;
      transition: transform 0.3s ease;
    }
   
    .cta-button:hover span {
      transform: translateY(-1px);
      color: #000000;
    }
    .cta-button:hover {
      transform: translateY(-2px);
      box-shadow: 0 6px 15px rgba(255,255,255,0.2);
      background: #ffffff;
      color: #000000;
    }
    @keyframes whiteGlow {
      from {
        box-shadow: 0 0 5px rgba(255,255,255,0.2), 0 0 10px rgba(255,255,255,0.1);
      }
      to {
        box-shadow: 0 0 10px rgba(255,255,255,0.3), 0 0 20px rgba(255,255,255,0.15);
      }
    }
    .scroll-indicator {
      position: absolute;
      bottom: 15px;
      left: 50%;
      transform: translateX(-50%);
      opacity: 0;
      animation: scrollIndicator 2s ease-in-out 2.5s forwards;
    }
    @keyframes scrollIndicator {
      0% {
        opacity: 0;
        transform: translateX(-50%) translateY(-10px);
      }
      50% {
        opacity: 1;
        transform: translateX(-50%) translateY(0);
      }
      100% {
        opacity: 1;
        transform: translateX(-50%) translateY(0);
      }
    }
    .scroll-arrow {
      width: 16px;
      height: 16px;
      border-right: 1px solid #ffffff;
      border-bottom: 1px solid #ffffff;
      transform: rotate(45deg);
      animation: bounce 2s infinite;
      opacity: 0.7;
    }
    @keyframes bounce {
      0%, 100% {
        transform: rotate(45deg) translateY(0);
      }
      50% {
        transform: rotate(45deg) translateY(-4px);
      }
    }
   
    /* Main Content */
    main {
      flex: 1;
    }
   
    .container {
      max-width: 1400px;
      margin: 0 auto;
      padding: 0 0.8rem;
    }
   
    .section {
      padding: 2rem 0;
    }
   
    .section-header {
      text-align: center;
      margin-bottom: 1.5rem;
      padding: 0 0.5rem;
    }
   
    .section-title {
      font-size: 1.4rem;
      font-weight: 300;
      margin-bottom: 0.6rem;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      color: var(--zara-black);
      line-height: 1.2;
    }
   
    .section-subtitle {
      color: var(--zara-dark-gray);
      max-width: 500px;
      margin: 0 auto;
      font-size: 0.8rem;
      font-weight: 300;
      letter-spacing: 1px;
      line-height: 1.4;
