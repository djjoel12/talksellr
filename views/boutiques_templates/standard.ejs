    async function addToCartHorizontal(productId, productName, productPrice, button) {
      try {
        // Sauvegarder l'état original du bouton
        const originalText = button.textContent;
        const originalBackground = button.style.background;
        const originalBorderColor = button.style.borderColor;
        
        button.disabled = true;
        button.textContent = 'AJOUT EN COURS...';

        const response = await fetch('/panier/ajouter/' + productId, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'X-Requested-With': 'XMLHttpRequest'
          },
          body: JSON.stringify({
            quantite: 1
          })
        });

        const data = await response.json();

        if (data.success) {
          showNotification(productName, productPrice + ' €');
          updateCartBadge(data.panierCount);
          
          button.textContent = '✓ AJOUTÉ !';
          button.style.background = '#28a745';
          button.style.borderColor = '#28a745';
          
          setTimeout(() => {
            button.disabled = false;
            button.textContent = originalText;
            button.style.background = originalBackground;
            button.style.borderColor = originalBorderColor;
          }, 2000);
        } else {
          throw new Error(data.message || 'Erreur lors de l\'ajout au panier');
        }
      } catch (error) {
        console.error('Erreur:', error);
        
        // Réinitialiser le bouton en cas d'erreur
        button.disabled = false;
        button.textContent = 'AJOUTER AU PANIER';
        
        // Optionnel : afficher un message d'erreur à l'utilisateur
