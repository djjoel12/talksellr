<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= boutique.nom %> - Collection Exclusive</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
    :root {
      --gucci-black: #000000;
      --gucci-white: #FFFFFF;
      --gucci-light-gray: #F5F5F5;
      --gucci-medium-gray: #E5E5E5;
      --gucci-dark-gray: #666666;
      --gucci-text: #1A1A1A;
      --gucci-border: #DDDDDD;
      --gucci-red: #AF1E2D;
    }
    
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }
    
    body {
      font-family: 'Helvetica Neue', Arial, sans-serif;
      color: var(--gucci-text);
      background: var(--gucci-white);
      line-height: 1.4;
      font-weight: 400;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }
    
    /* Header Style Gucci Actuel */
    header {
      background: var(--gucci-white);
      border-bottom: 1px solid var(--gucci-border);
      padding: 0;
      position: sticky;
      top: 0;
      z-index: 1000;
      backdrop-filter: blur(10px);
    }
    
    .header-top {
      border-bottom: 1px solid var(--gucci-border);
      padding: 0.8rem 0;
      font-size: 0.7rem;
      letter-spacing: 1px;
      text-transform: uppercase;
    }
    
    .header-container {
      max-width: 100%;
      margin: 0 auto;
      padding: 0 2rem;
    }
    
    .header-main {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 1.5rem 0;
    }
    
    .logo {
      font-size: 2rem;
      font-weight: 400;
      letter-spacing: 4px;
      color: var(--gucci-black);
      text-transform: uppercase;
      text-align: center;
      flex: 1;
    }
    
    .nav-links {
      display: flex;
      gap: 2.5rem;
      flex: 1;
      justify-content: flex-start;
    }
    
    .nav-links a {
      font-weight: 400;
      font-size: 0.75rem;
      letter-spacing: 1.2px;
      text-transform: uppercase;
      color: var(--gucci-black);
      text-decoration: none;
      transition: opacity 0.3s ease;
      opacity: 0.8;
    }
    
    .nav-links a:hover {
      opacity: 1;
    }
    
    .header-actions {
      display: flex;
      gap: 1.5rem;
      align-items: center;
      flex: 1;
      justify-content: flex-end;
    }
    
    .search-bar {
      display: flex;
      align-items: center;
      position: relative;
    }
    
    .search-bar input {
      border: none;
      outline: none;
      background: transparent;
      color: var(--gucci-black);
      padding: 0.5rem 0;
      width: 180px;
      font-size: 0.75rem;
      border-bottom: 1px solid transparent;
      transition: border-color 0.3s ease;
    }
    
    .search-bar input:focus {
      border-bottom-color: var(--gucci-black);
    }
    
    .search-bar input::placeholder {
      color: var(--gucci-dark-gray);
      font-weight: 400;
      letter-spacing: 1px;
    }
    
    .icon-btn {
      background: none;
      border: none;
      color: var(--gucci-black);
      font-size: 1rem;
      cursor: pointer;
      transition: opacity 0.3s ease;
      opacity: 0.8;
      padding: 0.5rem;
      position: relative;
    }
    
    .icon-btn:hover {
      opacity: 1;
    }
    
    .cart-badge {
      position: absolute;
      top: -2px;
      right: -2px;
      background: var(--gucci-black);
      color: var(--gucci-white);
      border-radius: 50%;
      width: 16px;
      height: 16px;
      font-size: 0.6rem;
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 400;
    }

    /* Hero Section Style Gucci Actuel */
    .hero {
      background: var(--gucci-white);
      padding: 0;
      position: relative;
      overflow: hidden;
      min-height: 90vh;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .hero-image {
      width: 100%;
      height: 90vh;
      object-fit: cover;
    }

    .hero-content {
      position: absolute;
      bottom: 4rem;
      left: 4rem;
      max-width: 500px;
      text-align: left;
    }

    .hero h1 {
      font-size: 3.5rem;
      font-weight: 400;
      margin-bottom: 1.5rem;
      letter-spacing: 3px;
      text-transform: uppercase;
      color: var(--gucci-white);
      line-height: 1.1;
    }

    .hero p {
      font-size: 1rem;
      margin-bottom: 2.5rem;
      font-weight: 400;
      letter-spacing: 1px;
      color: var(--gucci-white);
      line-height: 1.6;
      opacity: 0.9;
    }
    
    .cta-button {
      display: inline-block;
      background: var(--gucci-white);
      color: var(--gucci-black);
      padding: 1.2rem 3rem;
      font-weight: 400;
      font-size: 0.8rem;
      text-transform: uppercase;
      letter-spacing: 2px;
      transition: all 0.3s ease;
      border: 1px solid var(--gucci-white);
      cursor: pointer;
      text-decoration: none;
    }
    
    .cta-button:hover {
      background: transparent;
      color: var(--gucci-white);
    }

    /* Produits Section */
    .section {
      padding: 5rem 0;
    }
    
    .container {
      max-width: 1400px;
      margin: 0 auto;
      padding: 0 2rem;
    }
    
    .section-header {
      text-align: center;
      margin-bottom: 3rem;
    }
    
    .section-title {
      font-size: 1.8rem;
      font-weight: 400;
      margin-bottom: 1rem;
      letter-spacing: 3px;
      text-transform: uppercase;
      color: var(--gucci-black);
    }
    
    .section-subtitle {
      color: var(--gucci-dark-gray);
      max-width: 600px;
      margin: 0 auto;
      font-size: 0.9rem;
      font-weight: 400;
      letter-spacing: 1px;
      line-height: 1.6;
    }
    
    /* Produits Grid Style Gucci */
    .produits-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: 2rem;
    }
    
    .produit-card {
      background: var(--gucci-white);
      transition: all 0.3s ease;
      position: relative;
    }
    
    .produit-card:hover {
      transform: translateY(-5px);
    }
    
    .produit-image {
      position: relative;
      height: 500px;
      overflow: hidden;
      margin-bottom: 1.5rem;
    }

    .produit-image img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.6s ease;
    }

    .produit-card:hover .produit-image img {
      transform: scale(1.05);
    }

    .produit-badge {
      position: absolute;
      top: 1rem;
      left: 1rem;
      background: var(--gucci-white);
      color: var(--gucci-black);
      padding: 0.3rem 0.8rem;
      font-size: 0.7rem;
      font-weight: 400;
      letter-spacing: 1px;
      text-transform: uppercase;
    }
    
    .produit-content {
      text-align: center;
    }
    
    .produit-category {
      font-size: 0.7rem;
      font-weight: 400;
      color: var(--gucci-dark-gray);
      text-transform: uppercase;
      letter-spacing: 1.2px;
      margin-bottom: 0.5rem;
    }
    
    .produit-name {
      font-size: 0.9rem;
      font-weight: 400;
      margin-bottom: 0.8rem;
      color: var(--gucci-black);
      text-transform: uppercase;
      letter-spacing: 1px;
      line-height: 1.4;
    }
    
    .produit-prix {
      font-size: 0.9rem;
      font-weight: 400;
      color: var(--gucci-black);
      letter-spacing: 1px;
    }
    
    .produit-actions {
      display: flex;
      gap: 0.5rem;
      margin-top: 1rem;
    }
    
    .btn {
      display: inline-block;
      padding: 0.8rem 1.5rem;
      text-align: center;
      font-weight: 400;
      font-size: 0.7rem;
      cursor: pointer;
      transition: all 0.3s ease;
      border: 1px solid var(--gucci-black);
      text-transform: uppercase;
      letter-spacing: 1.2px;
      text-decoration: none;
      flex: 1;
    }
    
    .btn-primary {
      background: var(--gucci-black);
      color: var(--gucci-white);
    }
    
    .btn-primary:hover {
      background: var(--gucci-white);
      color: var(--gucci-black);
    }
    
    .btn-outline {
      background: var(--gucci-white);
      color: var(--gucci-black);
      border: 1px solid var(--gucci-black);
    }
    
    .btn-outline:hover {
      background: var(--gucci-black);
      color: var(--gucci-white);
    }

    /* Newsletter Section */
    .newsletter {
      background: var(--gucci-light-gray);
      padding: 4rem 0;
      text-align: center;
    }
    
    .newsletter-content {
      max-width: 500px;
      margin: 0 auto;
    }
    
    .newsletter-form {
      display: flex;
      gap: 1rem;
      margin-top: 2rem;
    }
    
    .newsletter-input {
      flex: 1;
      padding: 1rem;
      border: 1px solid var(--gucci-border);
      background: var(--gucci-white);
      font-size: 0.8rem;
      font-weight: 400;
      letter-spacing: 1px;
    }
    
    .newsletter-input::placeholder {
      color: var(--gucci-dark-gray);
    }
    
    /* Footer Style Gucci */
    footer {
      background: var(--gucci-black);
      color: var(--gucci-white);
      padding: 4rem 0 2rem;
      margin-top: auto;
    }
    
    .footer-content {
      display: grid;
      grid-template-columns: 2fr 1fr 1fr 1fr;
      gap: 3rem;
      margin-bottom: 3rem;
    }
    
    .footer-column h3 {
      font-size: 0.8rem;
      margin-bottom: 2rem;
      font-weight: 400;
      color: var(--gucci-white);
      text-transform: uppercase;
      letter-spacing: 2px;
    }
    
    .footer-links {
      list-style: none;
    }
    
    .footer-links li {
      margin-bottom: 1rem;
    }
    
    .footer-links a {
      color: var(--gucci-light-gray);
      transition: all 0.3s ease;
      font-size: 0.75rem;
      font-weight: 400;
      letter-spacing: 1px;
      text-transform: uppercase;
      text-decoration: none;
    }
    
    .footer-links a:hover {
      color: var(--gucci-white);
    }
    
    .social-links {
      display: flex;
      gap: 1rem;
      margin-top: 2rem;
    }
    
    .social-link {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 40px;
      height: 40px;
      background: var(--gucci-white);
      color: var(--gucci-black);
      border-radius: 0;
      transition: all 0.3s ease;
      font-size: 1rem;
      text-decoration: none;
    }
    
    .social-link:hover {
      background: var(--gucci-dark-gray);
      color: var(--gucci-white);
    }
    
    .footer-bottom {
      text-align: center;
      padding-top: 2rem;
      border-top: 1px solid var(--gucci-dark-gray);
      color: var(--gucci-light-gray);
      font-size: 0.7rem;
      font-weight: 400;
      letter-spacing: 1px;
      text-transform: uppercase;
    }
    
    /* Responsive */
    @media (max-width: 1024px) {
      .footer-content {
        grid-template-columns: 1fr 1fr;
        gap: 2rem;
      }
      
      .nav-links {
        gap: 2rem;
      }
    }
    
    @media (max-width: 768px) {
      .header-main {
        flex-direction: column;
        gap: 1.5rem;
        padding: 1rem 0;
      }
      
      .nav-links {
        order: 3;
        justify-content: center;
        flex-wrap: wrap;
        gap: 1.5rem;
      }
      
      .logo {
        order: 1;
        flex: none;
      }
      
      .header-actions {
        order: 2;
        flex: none;
      }
      
      .search-bar input {
        width: 120px;
      }
      
      .hero-content {
        left: 2rem;
        bottom: 2rem;
        max-width: 300px;
      }

      .hero h1 {
        font-size: 2rem;
      }

      .hero p {
        font-size: 0.9rem;
      }

      .cta-button {
        padding: 1rem 2rem;
        font-size: 0.7rem;
      }
      
      .section-title {
        font-size: 1.5rem;
      }
      
      .produits-grid {
        grid-template-columns: 1fr;
        gap: 2rem;
      }
      
      .produit-image {
        height: 400px;
      }
      
      .footer-content {
        grid-template-columns: 1fr;
      }
      
      .newsletter-form {
        flex-direction: column;
      }
    }
  </style>
</head>
<body>
  <!-- Header -->
  <header>
    <div class="header-top">
      <div class="header-container" style="text-align: center;">
        LIVRAISON GRATUITE POUR LES COMMANDES SUPÉRIEURES À 500€
      </div>
    </div>
    
    <div class="header-container">
      <div class="header-main">
        <nav class="nav-links">
          <a href="#nouveautes">NOUVEAUTÉS</a>
          <a href="#femme">FEMME</a>
          <a href="#homme">HOMME</a>
          <a href="#enfant">ENFANT</a>
          <a href="#maison">MAISON</a>
        </nav>
        
        <div class="logo"><%= boutique.nom %></div>
        
        <div class="header-actions">
          <div class="search-bar">
            <input type="text" placeholder="RECHERCHER">
            <button class="icon-btn">
              <i class="fas fa-search"></i>
            </button>
          </div>
          
          <% if (typeof user !== 'undefined' && user) { %>
            <a href="/vendeur/dashboard" class="icon-btn">
              <i class="fas fa-user"></i>
            </a>
          <% } else { %>
            <a href="/auth/login" class="icon-btn">
              <i class="fas fa-user"></i>
            </a>
          <% } %>
          
          <a href="/panier" class="icon-btn" style="position: relative;" id="cartIcon">
            <i class="fas fa-shopping-bag"></i>
            <% if (typeof panierCount !== 'undefined' && panierCount > 0) { %>
              <span class="cart-badge" id="cartBadge"><%= panierCount %></span>
            <% } %>
          </a>
        </div>
      </div>
    </div>
  </header>

  <!-- Main Content -->
  <main>
    <!-- Hero Section -->
    <section class="hero" id="accueil">
      <!-- Remplacez cette URL par votre image hero -->
      <img src="https://images.unsplash.com/photo-1591561954557-26941169b49e?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=1890&q=80" 
           alt="Collection <%= boutique.nom %>" 
           class="hero-image">
      
      <div class="hero-content">
        <h1>NOUVELLE COLLECTION</h1>
        <p>Découvrez les dernières créations et pièces exclusives de la saison</p>
        <a href="#produits" class="cta-button">EXPLORER</a>
      </div>
    </section>

    <!-- Produits Section -->
    <section class="section" id="produits">
      <div class="container">
        <div class="section-header">
          <h2 class="section-title">LES INCONTOURNABLES</h2>
          <p class="section-subtitle">Pièces signature et essentiels de la collection</p>
        </div>
        
        <% if (produits && produits.length > 0) { %>
          <div class="produits-grid">
            <% produits.forEach((produit, index) => { %>
              <div class="produit-card">
                <div class="produit-image">
                  <% if (produit.imagesGallery && produit.imagesGallery.length > 0) { %>
                    <img src="<%= produit.imagesGallery[0].url %>" alt="<%= produit.nom %>">
                  <% } else if (produit.image) { %>
                    <img src="<%= produit.image %>" alt="<%= produit.nom %>">
                  <% } else { %>
                    <div style="background: #f5f5f5; height: 100%; display: flex; align-items: center; justify-content: center; color: #999;">
                      <i class="fas fa-image" style="font-size: 2rem;"></i>
                    </div>
                  <% } %>
                  
                  <% if (produit.nouveau) { %>
                    <div class="produit-badge">NOUVEAU</div>
                  <% } %>
                </div>

                <div class="produit-content">
                  <div class="produit-category"><%= produit.categorie || 'ACCESSOIRES' %></div>
                  <h3 class="produit-name"><%= produit.nom %></h3>
                  <p class="produit-prix"><%= produit.prix %> <%= produit.devise %></p>
                  <div class="produit-actions">
                    <form action="/panier/ajouter/<%= produit._id %>" method="POST" style="display: inline; flex: 1;" class="add-to-cart-form">
                      <input type="hidden" name="produitNom" value="<%= produit.nom %>">
                      <input type="hidden" name="produitPrix" value="<%= produit.prix %>">
                      <button type="submit" class="btn btn-primary add-to-cart-btn">
                        AJOUTER AU PANIER
                      </button>
                    </form>
                  </div>
                </div>
              </div>
            <% }) %>
          </div>
        <% } else { %>
          <div style="text-align: center; padding: 4rem 2rem;">
            <h3 style="font-size: 1.2rem; font-weight: 400; letter-spacing: 2px; margin-bottom: 1rem; text-transform: uppercase;">COLLECTION À VENIR</h3>
            <p style="color: var(--gucci-dark-gray); margin-bottom: 2rem;">Notre nouvelle collection sera bientôt disponible.</p>
            <a href="#" class="btn btn-outline">ÊTRE INFORMÉ</a>
          </div>
        <% } %>
      </div>
    </section>

    <!-- Bannière Secondaire -->
    <section style="background: var(--gucci-black); color: var(--gucci-white); padding: 6rem 0; text-align: center;">
      <div class="container">
        <h2 style="font-size: 2rem; font-weight: 400; letter-spacing: 3px; margin-bottom: 1.5rem; text-transform: uppercase;">L'ART DE LA MODE</h2>
        <p style="max-width: 600px; margin: 0 auto; font-size: 1rem; letter-spacing: 1px; line-height: 1.6; opacity: 0.9;">
          Découvrez l'excellence du savoir-faire et l'innovation qui définissent notre maison
        </p>
      </div>
    </section>

    <!-- Newsletter Section -->
    <section class="newsletter">
      <div class="container">
        <div class="newsletter-content">
          <h3 class="section-title">NEWSLETTER</h3>
          <p class="section-subtitle">Soyez le premier informé de nos nouvelles collections et offres exclusives</p>
          <form class="newsletter-form">
            <input type="email" placeholder="VOTRE ADRESSE EMAIL" class="newsletter-input" required>
            <button type="submit" class="btn btn-primary">S'INSCRIRE</button>
          </form>
        </div>
      </div>
    </section>
  </main>

  <!-- Footer -->
  <footer>
    <div class="container">
      <div class="footer-content">
        <div class="footer-column">
          <h3><%= boutique.nom %></h3>
          <p style="color: var(--gucci-light-gray); font-size: 0.75rem; font-weight: 400; letter-spacing: 1px; line-height: 1.6; margin-bottom: 2rem; max-width: 300px;">
            Depuis sa fondation, <%= boutique.nom %> incarne l'excellence du luxe et l'innovation créative.
          </p>
          <div class="social-links">
            <a href="#" class="social-link"><i class="fab fa-instagram"></i></a>
            <a href="#" class="social-link"><i class="fab fa-facebook-f"></i></a>
            <a href="#" class="social-link"><i class="fab fa-twitter"></i></a>
            <a href="#" class="social-link"><i class="fab fa-pinterest"></i></a>
          </div>
        </div>
        
        <div class="footer-column">
          <h3>BOUTIQUE</h3>
          <ul class="footer-links">
            <li><a href="#nouveautes">Nouveautés</a></li>
            <li><a href="#femme">Femme</a></li>
            <li><a href="#homme">Homme</a></li>
            <li><a href="#enfant">Enfant</a></li>
            <li><a href="#maison">Maison</a></li>
          </ul>
        </div>
        
        <div class="footer-column">
          <h3>SERVICE CLIENT</h3>
          <ul class="footer-links">
            <li><a href="#">Contact</a></li>
            <li><a href="#">Livraison</a></li>
            <li><a href="#">Retours</a></li>
            <li><a href="#">Guide des tailles</a></li>
            <li><a href="#">FAQ</a></li>
          </ul>
        </div>
        
        <div class="footer-column">
          <h3>À PROPOS</h3>
          <ul class="footer-links">
            <li><a href="#">Notre histoire</a></li>
            <li><a href="#">Durabilité</a></li>
            <li><a href="#">Carrières</a></li>
            <li><a href="#">Presse</a></li>
            <li><a href="#">Événements</a></li>
          </ul>
        </div>
      </div>
      
      <div class="footer-bottom">
        <p>&copy; 2024 <%= boutique.nom %>. TOUS DROITS RÉSERVÉS</p>
      </div>
    </div>
  </footer>

  <script>
    // Gestion de l'ajout au panier avec AJAX
    document.addEventListener('DOMContentLoaded', function() {
      const forms = document.querySelectorAll('.add-to-cart-form');
      
      forms.forEach(form => {
        form.addEventListener('submit', function(e) {
          e.preventDefault();
          
          const formData = new FormData(this);
          const productName = this.querySelector('input[name="produitNom"]').value;
          const productPrice = this.querySelector('input[name="produitPrix"]').value;
          const submitBtn = this.querySelector('.add-to-cart-btn');
          
          // Désactiver le bouton pendant la requête
          submitBtn.disabled = true;
          submitBtn.textContent = 'AJOUT...';
          
          // Envoyer la requête AJAX
          fetch(this.action, {
            method: 'POST',
            body: formData,
            headers: {
              'X-Requested-With': 'XMLHttpRequest'
            }
          })
          .then(response => response.json())
          .then(data => {
            if (data.success) {
              // Mettre à jour le badge du panier
              updateCartBadge(data.panierCount);
              
              // Effet de confirmation sur le bouton
              submitBtn.textContent = '✓ AJOUTÉ';
              submitBtn.style.background = '#0A7C0A';
              
              setTimeout(() => {
                submitBtn.disabled = false;
                submitBtn.textContent = 'AJOUTER AU PANIER';
                submitBtn.style.background = '';
              }, 2000);
            }
          })
          .catch(error => {
            console.error('Erreur:', error);
            this.submit();
          });
        });
      });
      
      // Fonction pour mettre à jour le badge du panier
      function updateCartBadge(count) {
        const cartIcon = document.getElementById('cartIcon');
        let badge = document.getElementById('cartBadge');
        
        if (!badge) {
          badge = document.createElement('span');
          badge.id = 'cartBadge';
          badge.className = 'cart-badge';
          cartIcon.appendChild(badge);
        }
        
        badge.textContent = count;
      }

      // Smooth scroll pour les ancres
      document.querySelectorAll('a[href^="#"]').forEach(anchor => {
        anchor.addEventListener('click', function (e) {
          e.preventDefault();
          const target = document.querySelector(this.getAttribute('href'));
          if (target) {
            target.scrollIntoView({
              behavior: 'smooth',
              block: 'start'
            });
          }
        });
      });
    });
  </script>
</body>
</html>