<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Mes Commandes • Tableau de Bord</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
    :root {
      --primary: #2563eb;
      --primary-dark: #1d4ed8;
      --primary-light: #dbeafe;
      --secondary: #64748b;
      --success: #10b981;
      --warning: #f59e0b;
      --error: #ef4444;
      --background: #f8fafc;
      --surface: #ffffff;
      --text-primary: #1e293b;
      --text-secondary: #64748b;
      --text-tertiary: #94a3b8;
      --border: #e2e8f0;
      --shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.1), 0 1px 2px 0 rgba(0, 0, 0, 0.06);
      --shadow-lg: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
      --radius: 8px;
      --radius-lg: 12px;
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      background: var(--background);
      color: var(--text-primary);
      line-height: 1.5;
      font-weight: 400;
    }

    .container {
      max-width: 1400px;
      margin: 0 auto;
      padding: 24px;
    }

    /* Header */
    .dashboard-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 32px;
      padding-bottom: 24px;
      border-bottom: 1px solid var(--border);
    }

    .header-left {
      display: flex;
      align-items: center;
      gap: 16px;
    }

    .back-btn {
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 8px 16px;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      color: var(--text-secondary);
      text-decoration: none;
      font-weight: 500;
      transition: all 0.2s ease;
    }

    .back-btn:hover {
      background: var(--primary-light);
      border-color: var(--primary);
      color: var(--primary);
    }

    .page-title {
      font-size: 28px;
      font-weight: 700;
      color: var(--text-primary);
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .page-title i {
      color: var(--primary);
    }

    .header-actions {
      display: flex;
      gap: 12px;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 10px 20px;
      border: none;
      border-radius: var(--radius);
      font-weight: 600;
      font-size: 14px;
      cursor: pointer;
      transition: all 0.2s ease;
      text-decoration: none;
    }

    .btn-primary {
      background: var(--primary);
      color: white;
    }

    .btn-primary:hover {
      background: var(--primary-dark);
      transform: translateY(-1px);
    }

    .btn-secondary {
      background: var(--surface);
      color: var(--text-primary);
      border: 1px solid var(--border);
    }

    .btn-secondary:hover {
      background: var(--background);
      border-color: var(--text-tertiary);
    }

    /* Stats Grid */
    .stats-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      gap: 20px;
      margin-bottom: 32px;
    }

    .stat-card {
      background: var(--surface);
      padding: 24px;
      border-radius: var(--radius-lg);
      box-shadow: var(--shadow);
      border: 1px solid var(--border);
      transition: all 0.3s ease;
    }

    .stat-card:hover {
      transform: translateY(-2px);
      box-shadow: var(--shadow-lg);
    }

    .stat-header {
      display: flex;
      justify-content: between;
      align-items: flex-start;
      margin-bottom: 12px;
    }

    .stat-icon {
      width: 48px;
      height: 48px;
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 20px;
    }

    .stat-icon.blue { background: var(--primary-light); color: var(--primary); }
    .stat-icon.green { background: #d1fae5; color: var(--success); }
    .stat-icon.orange { background: #fef3c7; color: var(--warning); }
    .stat-icon.purple { background: #e9d5ff; color: #8b5cf6; }

    .stat-content {
      flex: 1;
    }

    .stat-number {
      font-size: 32px;
      font-weight: 700;
      margin-bottom: 4px;
      color: var(--text-primary);
    }

    .stat-label {
      color: var(--text-secondary);
      font-size: 14px;
      font-weight: 500;
    }

    .stat-trend {
      font-size: 12px;
      font-weight: 600;
      padding: 4px 8px;
      border-radius: 20px;
      background: var(--success);
      color: white;
    }

    /* Filters Bar */
    .filters-bar {
      background: var(--surface);
      padding: 20px;
      border-radius: var(--radius-lg);
      margin-bottom: 24px;
      box-shadow: var(--shadow);
      display: flex;
      gap: 16px;
      align-items: center;
      flex-wrap: wrap;
    }

    .search-box {
      position: relative;
      flex: 1;
      min-width: 300px;
    }

    .search-box input {
      width: 100%;
      padding: 12px 16px 12px 44px;
      border: 1px solid var(--border);
      border-radius: var(--radius);
      background: var(--background);
      font-size: 14px;
      transition: all 0.2s ease;
    }

    .search-box input:focus {
      outline: none;
      border-color: var(--primary);
      box-shadow: 0 0 0 3px var(--primary-light);
    }

    .search-icon {
      position: absolute;
      left: 16px;
      top: 50%;
      transform: translateY(-50%);
      color: var(--text-tertiary);
    }

    .filter-group {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .filter-label {
      color: var(--text-secondary);
      font-size: 14px;
      font-weight: 500;
    }

    .filter-select {
      padding: 10px 12px;
      border: 1px solid var(--border);
      border-radius: var(--radius);
      background: var(--surface);
      color: var(--text-primary);
      font-size: 14px;
      min-width: 140px;
      cursor: pointer;
    }

    .filter-select:focus {
      outline: none;
      border-color: var(--primary);
    }

    /* Orders Grid */
    .orders-grid {
      display: grid;
      gap: 20px;
    }

    .order-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      overflow: hidden;
      box-shadow: var(--shadow);
      transition: all 0.3s ease;
    }

    .order-card:hover {
      transform: translateY(-2px);
      box-shadow: var(--shadow-lg);
    }

    .order-header {
      padding: 20px 24px;
      background: var(--background);
      border-bottom: 1px solid var(--border);
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .order-info {
      display: flex;
      align-items: center;
      gap: 16px;
    }

    .order-id {
      font-weight: 700;
      font-size: 16px;
      color: var(--text-primary);
    }

    .order-date {
      color: var(--text-secondary);
      font-size: 14px;
    }

    .customer-badge {
      padding: 4px 8px;
      border-radius: 6px;
      font-size: 12px;
      font-weight: 600;
      text-transform: uppercase;
    }

    .customer-badge.registered { background: #d1fae5; color: #065f46; }
    .customer-badge.guest { background: #fef3c7; color: #92400e; }

    .status-badge {
      padding: 8px 16px;
      border-radius: 20px;
      font-size: 12px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .status-pending { background: #fef3c7; color: #92400e; }
    .status-confirmed { background: #dbeafe; color: #1e40af; }
    .status-processing { background: #fef3c7; color: #92400e; }
    .status-shipped { background: #d1fae5; color: #065f46; }
    .status-delivered { background: #dcfce7; color: #166534; }
    .status-cancelled { background: #fee2e2; color: #991b1b; }

    .order-body {
      padding: 24px;
    }

    .customer-info {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 16px;
      margin-bottom: 24px;
      padding: 16px;
      background: var(--background);
      border-radius: var(--radius);
    }

    .info-item {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .info-icon {
      width: 32px;
      height: 32px;
      border-radius: 8px;
      background: var(--primary-light);
      color: var(--primary);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 14px;
    }

    .info-content {
      flex: 1;
    }

    .info-label {
      font-size: 12px;
      color: var(--text-secondary);
      margin-bottom: 2px;
    }

    .info-value {
      font-weight: 600;
      color: var(--text-primary);
    }

    .products-section {
      margin-bottom: 24px;
    }

    .section-title {
      font-size: 16px;
      font-weight: 600;
      margin-bottom: 16px;
      color: var(--text-primary);
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .products-grid {
      display: grid;
      gap: 12px;
    }

    .product-item {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 16px;
      background: var(--background);
      border-radius: var(--radius);
      border: 1px solid var(--border);
    }

    .product-info {
      display: flex;
      align-items: center;
      gap: 16px;
      flex: 1;
    }

    .product-image {
      width: 60px;
      height: 60px;
      border-radius: 8px;
      overflow: hidden;
      flex-shrink: 0;
      background: var(--surface);
      border: 1px solid var(--border);
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .product-image img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .product-image-placeholder {
      width: 100%;
      height: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
      background: var(--background);
      color: var(--text-tertiary);
      font-size: 20px;
    }

    .product-details {
      flex: 1;
    }

    .product-name {
      font-weight: 600;
      margin-bottom: 4px;
      color: var(--text-primary);
    }

    .product-meta {
      display: flex;
      gap: 12px;
      font-size: 13px;
      color: var(--text-secondary);
    }

    .product-price {
      text-align: right;
      min-width: 120px;
    }

    .product-total {
      font-weight: 700;
      font-size: 16px;
      color: var(--text-primary);
      margin-bottom: 2px;
    }

    .product-unit {
      font-size: 13px;
      color: var(--text-secondary);
    }

    .order-total {
      text-align: right;
      font-size: 18px;
      font-weight: 700;
      margin-top: 20px;
      padding-top: 20px;
      border-top: 2px solid var(--border);
      color: var(--text-primary);
    }

    .order-actions {
      padding: 20px 24px;
      background: var(--background);
      border-top: 1px solid var(--border);
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 16px;
    }

    .action-group {
      display: flex;
      gap: 12px;
      align-items: center;
    }

    .status-selector {
      padding: 10px 12px;
      border: 1px solid var(--border);
      border-radius: var(--radius);
      background: var(--surface);
      color: var(--text-primary);
      min-width: 160px;
      font-size: 14px;
    }

    .save-btn {
      background: var(--primary);
      color: white;
      border: none;
      padding: 10px 20px;
      border-radius: var(--radius);
      font-weight: 600;
      cursor: pointer;
      transition: all 0.2s ease;
    }

    .save-btn:hover {
      background: var(--primary-dark);
    }

    .message {
      font-size: 14px;
      margin-left: 12px;
      font-weight: 500;
    }

    .message.success { color: var(--success); }
    .message.error { color: var(--error); }
    .message.loading { color: var(--text-secondary); }

    .action-buttons {
      display: flex;
      gap: 8px;
    }

    .icon-btn {
      width: 40px;
      height: 40px;
      border-radius: var(--radius);
      border: 1px solid var(--border);
      background: var(--surface);
      color: var(--text-secondary);
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      transition: all 0.2s ease;
      text-decoration: none;
    }

    .icon-btn:hover {
      background: var(--primary);
      color: white;
      border-color: var(--primary);
    }

    .icon-btn.whatsapp:hover {
      background: #25D366;
      border-color: #25D366;
    }

    /* Empty State */
    .empty-state {
      text-align: center;
      padding: 80px 20px;
      background: var(--surface);
      border-radius: var(--radius-lg);
      box-shadow: var(--shadow);
    }

    .empty-state-icon {
      font-size: 64px;
      margin-bottom: 24px;
      opacity: 0.5;
      color: var(--text-tertiary);
    }

    .empty-state h3 {
      font-size: 20px;
      font-weight: 600;
      margin-bottom: 12px;
      color: var(--text-primary);
    }

    .empty-state p {
      color: var(--text-secondary);
      margin-bottom: 24px;
      max-width: 400px;
      margin-left: auto;
      margin-right: auto;
    }

    /* Responsive */
    @media (max-width: 1024px) {
      .container {
        padding: 16px;
      }
      
      .dashboard-header {
        flex-direction: column;
        gap: 16px;
        align-items: flex-start;
      }
      
      .header-actions {
        width: 100%;
        justify-content: flex-end;
      }
    }

    @media (max-width: 768px) {
      .filters-bar {
        flex-direction: column;
        align-items: stretch;
      }
      
      .search-box {
        min-width: auto;
      }
      
      .order-header {
        flex-direction: column;
        gap: 12px;
        align-items: flex-start;
      }
      
      .order-actions {
        flex-direction: column;
        align-items: stretch;
      }
      
      .action-group {
        justify-content: space-between;
      }
      
      .product-item {
        flex-direction: column;
        align-items: flex-start;
        gap: 12px;
      }
      
      .product-price {
        text-align: left;
        width: 100%;
        display: flex;
        justify-content: space-between;
        align-items: center;
      }
    }

    @media (max-width: 480px) {
      .stats-grid {
        grid-template-columns: 1fr;
      }
      
      .customer-info {
        grid-template-columns: 1fr;
      }
      
      .action-buttons {
        width: 100%;
        justify-content: space-between;
      }
    }
  </style>
</head>
<body>
  <div class="container">
    <!-- Header -->
    <div class="dashboard-header">
      <div class="header-left">
        <a href="/vendeur/dashboard" class="back-btn">
          <i class="fas fa-arrow-left"></i>
          Retour au Dashboard
        </a>
        <h1 class="page-title">
          <i class="fas fa-shopping-bag"></i>
          Mes Commandes
        </h1>
      </div>
      <div class="header-actions">
        <button class="btn btn-secondary">
          <i class="fas fa-download"></i>
          Exporter
        </button>
        <button class="btn btn-primary">
          <i class="fas fa-sync"></i>
          Actualiser
        </button>
      </div>
    </div>

    <!-- Stats Grid -->
    <div class="stats-grid">
      <div class="stat-card">
        <div class="stat-header">
          <div class="stat-icon blue">
            <i class="fas fa-shopping-bag"></i>
          </div>
          <div class="stat-content">
            <div class="stat-number"><%= commandes.length %></div>
            <div class="stat-label">Commandes Total</div>
          </div>
        </div>
      </div>
      <div class="stat-card">
        <div class="stat-header">
          <div class="stat-icon orange">
            <i class="fas fa-clock"></i>
          </div>
          <div class="stat-content">
            <div class="stat-number"><%= commandes.filter(c => c.statut === 'en_attente').length %></div>
            <div class="stat-label">En Attente</div>
          </div>
        </div>
      </div>
      <div class="stat-card">
        <div class="stat-header">
          <div class="stat-icon green">
            <i class="fas fa-cog"></i>
          </div>
          <div class="stat-content">
            <div class="stat-number"><%= commandes.filter(c => c.statut === 'en_preparation').length %></div>
            <div class="stat-label">En Préparation</div>
          </div>
        </div>
      </div>
      <div class="stat-card">
        <div class="stat-header">
          <div class="stat-icon purple">
            <i class="fas fa-user-clock"></i>
          </div>
          <div class="stat-content">
            <div class="stat-number"><%= commandes.filter(c => c.client.id === null).length %></div>
            <div class="stat-label">Clients Invités</div>
          </div>
        </div>
      </div>
    </div>

    <!-- Filters Bar -->
    <div class="filters-bar">
      <div class="search-box">
        <i class="fas fa-search search-icon"></i>
        <input type="text" placeholder="Rechercher commandes, clients, produits..." onkeyup="rechercherCommandes()">
      </div>
      
      <div class="filter-group">
        <span class="filter-label">Statut:</span>
        <select class="filter-select" onchange="filtrerCommandes()">
          <option value="all">Tous les statuts</option>
          <option value="en_attente">En attente</option>
          <option value="confirmee">Confirmée</option>
          <option value="en_preparation">En préparation</option>
          <option value="expediee">Expédiée</option>
          <option value="livree">Livrée</option>
          <option value="annulee">Annulée</option>
        </select>
      </div>
      
      <div class="filter-group">
        <span class="filter-label">Trier par:</span>
        <select class="filter-select" onchange="trierCommandes()">
          <option value="date-desc">Plus récentes</option>
          <option value="date-asc">Plus anciennes</option>
          <option value="total-desc">Montant (↓)</option>
          <option value="total-asc">Montant (↑)</option>
        </select>
      </div>
    </div>

    <!-- Orders List -->
    <% if (commandes.length === 0) { %>
      <div class="empty-state">
        <div class="empty-state-icon">
          <i class="fas fa-shopping-bag"></i>
        </div>
        <h3>Aucune Commande</h3>
        <p>Lorsque les clients achètent vos produits, leurs commandes apparaîtront ici.</p>
        <button class="btn btn-primary">
          <i class="fas fa-sync"></i>
          Vérifier les Nouvelles Commandes
        </button>
      </div>
    <% } else { %>
      <div class="orders-grid">
        <% commandes.forEach((commande, index) => { %>
          <div class="order-card" data-commande-id="<%= commande._id %>" data-statut="<%= commande.statut %>" data-total="<%= commande.total %>" data-date="<%= commande.dateCreation %>">
            
            <!-- Order Header -->
            <div class="order-header">
              <div class="order-info">
                <div class="order-id">Commande #<%= commande.numeroCommande %></div>
                <div class="order-date"><%= new Date(commande.dateCreation).toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' }) %></div>
                <span class="customer-badge <%= commande.client.id ? 'registered' : 'guest' %>">
                  <%= commande.client.id ? 'Client Enregistré' : 'Client Invité' %>
                </span>
              </div>
              <span class="status-badge status-<%= 
                commande.statut === 'en_attente' ? 'pending' :
                commande.statut === 'confirmee' ? 'confirmed' :
                commande.statut === 'en_preparation' ? 'processing' :
                commande.statut === 'expediee' ? 'shipped' :
                commande.statut === 'livree' ? 'delivered' :
                commande.statut === 'annulee' ? 'cancelled' : 'pending'
              %>">
                <%= 
                  commande.statut === 'en_attente' ? 'En Attente' :
                  commande.statut === 'confirmee' ? 'Confirmée' :
                  commande.statut === 'en_preparation' ? 'En Préparation' :
                  commande.statut === 'expediee' ? 'Expédiée' :
                  commande.statut === 'livree' ? 'Livrée' :
                  commande.statut === 'annulee' ? 'Annulée' : 'En Attente'
                %>
              </span>
            </div>

            <!-- Order Body -->
            <div class="order-body">
              <!-- Customer Info -->
              <div class="customer-info">
                <div class="info-item">
                  <div class="info-icon">
                    <i class="fas fa-user"></i>
                  </div>
                  <div class="info-content">
                    <div class="info-label">Client</div>
                    <div class="info-value"><%= commande.client.nom %></div>
                  </div>
                </div>
                <div class="info-item">
                  <div class="info-icon">
                    <i class="fas fa-phone"></i>
                  </div>
                  <div class="info-content">
                    <div class="info-label">Téléphone</div>
                    <div class="info-value"><%= commande.client.telephone %></div>
                  </div>
                </div>
                <div class="info-item">
                  <div class="info-icon">
                    <i class="fas fa-map-marker-alt"></i>
                  </div>
                  <div class="info-content">
                    <div class="info-label">Adresse</div>
                    <div class="info-value"><%= commande.client.adresse %></div>
                  </div>
                </div>
              </div>

              <!-- Products -->
              <div class="products-section">
                <h3 class="section-title">
                  <i class="fas fa-box"></i>
                  Produits Commandés (<%= commande.produits.length %>)
                </h3>
                <div class="products-grid">
                  <% commande.produits.forEach((produit, pIndex) => { %>
                    <div class="product-item">
                      <div class="product-info">
                        <div class="product-image">
                          <% 
                            let imageUrl = '';
                            if (produit.produitId && produit.produitId.image) {
                              imageUrl = produit.produitId.image;
                            } else if (produit.produitId && produit.produitId.imagesGallery && produit.produitId.imagesGallery.length > 0) {
                              imageUrl = produit.produitId.imagesGallery[0].url;
                            } else if (produit.image) {
                              imageUrl = produit.image;
                            }
                          %>
                          
                          <% if (imageUrl) { %>
                            <img src="<%= imageUrl %>" 
                                 alt="<%= produit.produitId ? produit.produitId.nom : produit.nom %>"
                                 onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
                            <div class="product-image-placeholder" style="display: none;">
                              <i class="fas fa-box"></i>
                            </div>
                          <% } else { %>
                            <div class="product-image-placeholder">
                              <i class="fas fa-box"></i>
                            </div>
                          <% } %>
                        </div>
                        
                        <div class="product-details">
                          <div class="product-name">
                            <%= produit.produitId ? produit.produitId.nom : produit.nom %>
                          </div>
                          <div class="product-meta">
                            <span>Quantité: <strong><%= produit.quantite %></strong></span>
                            <% if (produit.vendeurId && produit.vendeurId.nom) { %>
                              <span>• Vendeur: <%= produit.vendeurId.nom %></span>
                            <% } %>
                            <% if (produit.produitId && produit.produitId.sku) { %>
                              <span>• SKU: <%= produit.produitId.sku %></span>
                            <% } %>
                          </div>
                        </div>
                      </div>
                      <div class="product-price">
                        <div class="product-total"><%= (produit.prix * produit.quantite).toFixed(2) %> <%= produit.devise %></div>
                        <div class="product-unit"><%= produit.prix %> <%= produit.devise %>/unité</div>
                      </div>
                    </div>
                  <% }) %>
                </div>
              </div>

              <!-- Order Total -->
              <div class="order-total">
                Total: <span style="color: var(--primary);"><%= commande.total.toFixed(2) %> <%= commande.produits[0] && commande.produits[0].devise %></span>
              </div>
            </div>

            <!-- Order Actions -->
            <div class="order-actions">
              <div class="action-group">
                <select class="status-selector" id="statut-<%= commande._id %>">
                  <option value="En attente" <%= commande.statut === 'en_attente' ? 'selected' : '' %>>En attente</option>
                  <option value="Confirmée" <%= commande.statut === 'confirmee' ? 'selected' : '' %>>Confirmée</option>
                  <option value="En préparation" <%= commande.statut === 'en_preparation' ? 'selected' : '' %>>En préparation</option>
                  <option value="Expédiée" <%= commande.statut === 'expediee' ? 'selected' : '' %>>Expédiée</option>
                  <option value="Livrée" <%= commande.statut === 'livree' ? 'selected' : '' %>>Livrée</option>
                  <option value="Annulée" <%= commande.statut === 'annulee' ? 'selected' : '' %>>Annulée</option>
                </select>
                <button class="save-btn" onclick="mettreAJourStatut('<%= commande._id %>')">
                  <i class="fas fa-save"></i>
                  Sauvegarder
                </button>
                <span id="message-<%= commande._id %>" class="message"></span>
              </div>

              <div class="action-buttons">
                <% if (commande.client.telephone) { %>
                  <a href="https://wa.me/<%= commande.client.telephone.replace(/\D/g, '') %>?text=Bonjour <%= encodeURIComponent(commande.client.nom) %>, je suis <%= user.nom %>. Votre commande #<%= commande.numeroCommande %> est actuellement '<%= 
                    commande.statut === 'en_attente' ? 'En attente' :
                    commande.statut === 'confirmee' ? 'Confirmée' :
                    commande.statut === 'en_preparation' ? 'En préparation' :
                    commande.statut === 'expediee' ? 'Expédiée' :
                    commande.statut === 'livree' ? 'Livrée' :
                    commande.statut === 'annulee' ? 'Annulée' : 'En attente'
                  %>'." 
                     target="_blank" 
                     class="icon-btn whatsapp"
                     title="Contacter via WhatsApp">
                    <i class="fab fa-whatsapp"></i>
                  </a>
                <% } %>
                <a href="/commandes/debug-vendeur" class="icon-btn" title="Informations de débogage">
                  <i class="fas fa-bug"></i>
                </a>
                <button class="icon-btn" title="Imprimer la commande">
                  <i class="fas fa-print"></i>
                </button>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    <% } %>
  </div>

  <script>
    // Fonction de mise à jour du statut
    async function mettreAJourStatut(commandeId) {
      const selecteur = document.getElementById(`statut-${commandeId}`);
      const messageElement = document.getElementById(`message-${commandeId}`);
      let nouveauStatut = selecteur.value;
      
      // Mapping des statuts français vers codes
      const statutsMap = {
        'En attente': 'en_attente',
        'Confirmée': 'confirmee',
        'En préparation': 'en_preparation',
        'Expédiée': 'expediee',
        'Livrée': 'livree',
        'Annulée': 'annulee'
      };
      
      // Convertir le statut français en code
      if (statutsMap[nouveauStatut]) {
        nouveauStatut = statutsMap[nouveauStatut];
      }
      
      messageElement.textContent = 'Mise à jour...';
      messageElement.className = 'message loading';
      
      try {
        const response = await fetch(`/commandes/${commandeId}/statut`, {
          method: 'POST',
          headers: { 
            'Content-Type': 'application/json',
            'Accept': 'application/json'
          },
          body: JSON.stringify({ statut: nouveauStatut })
        });
        
        const result = await response.json();
        
        if (result.success) {
          messageElement.textContent = 'Statut mis à jour';
          messageElement.className = 'message success';
          
          // Mettre à jour le badge de statut
          const badgeStatut = document.querySelector(`[data-commande-id="${commandeId}"] .status-badge`);
          const statutTexte = {
            'en_attente': 'En Attente',
            'confirmee': 'Confirmée',
            'en_preparation': 'En Préparation',
            'expediee': 'Expédiée',
            'livree': 'Livrée',
            'annulee': 'Annulée'
          }[nouveauStatut] || 'En Attente';
          
          badgeStatut.textContent = statutTexte;
          badgeStatut.className = `status-badge status-${nouveauStatut}`;
          
          // Mettre à jour l'attribut data
          document.querySelector(`[data-commande-id="${commandeId}"]`).dataset.statut = nouveauStatut;
          
          setTimeout(() => messageElement.textContent = '', 3000);
        } else {
          throw new Error(result.error);
        }
      } catch (error) {
        messageElement.textContent = 'Erreur: ' + error.message;
        messageElement.className = 'message error';
        setTimeout(() => messageElement.textContent = '', 5000);
      }
    }

    // Fonctions de filtrage
    function filtrerCommandes() {
      const filtre = document.querySelectorAll('.filter-select')[0].value;
      const commandes = document.querySelectorAll('.order-card');
      
      commandes.forEach(commande => {
        if (filtre === 'all' || commande.dataset.statut === filtre) {
          commande.style.display = 'block';
        } else {
          commande.style.display = 'none';
        }
      });
    }

    function rechercherCommandes() {
      const recherche = document.querySelector('.search-box input').value.toLowerCase();
      const commandes = document.querySelectorAll('.order-card');
      
      commandes.forEach(commande => {
        const texte = commande.textContent.toLowerCase();
        commande.style.display = texte.includes(recherche) ? 'block' : 'none';
      });
    }

    function trierCommandes() {
      const tri = document.querySelectorAll('.filter-select')[1].value;
      const container = document.querySelector('.orders-grid');
      const commandes = Array.from(document.querySelectorAll('.order-card'));
      
      commandes.sort((a, b) => {
        switch(tri) {
          case 'date-desc':
            return new Date(b.dataset.date) - new Date(a.dataset.date);
          case 'date-asc':
            return new Date(a.dataset.date) - new Date(b.dataset.date);
          case 'total-desc':
            return parseFloat(b.dataset.total) - parseFloat(a.dataset.total);
          case 'total-asc':
            return parseFloat(a.dataset.total) - parseFloat(b.dataset.total);
          default:
            return 0;
        }
      });
      
      // Réorganiser les commandes dans le DOM
      commandes.forEach(commande => container.appendChild(commande));
    }

    // Raccourci clavier (Ctrl + S)
    document.addEventListener('keydown', function(e) {
      if ((e.ctrlKey || e.metaKey) && e.key === 's') {
        e.preventDefault();
        const commandeActive = document.querySelector('.order-card:hover');
        if (commandeActive) {
          const commandeId = commandeActive.dataset.commandeId;
          mettreAJourStatut(commandeId);
        }
      }
    });

    // Initialisation
    document.addEventListener('DOMContentLoaded', function() {
      console.log('Tableau de bord des commandes chargé avec succès');
      console.log('Commandes affichées:', <%= commandes.length %>);
    });
  </script>
</body>
</html>