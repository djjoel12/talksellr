<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Login - TalkSellr</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      max-width: 400px;
      margin: 50px auto;
      padding: 20px;
    }
    .form-group {
      margin-bottom: 15px;
    }
    input {
      width: 100%;
      padding: 10px;
      margin: 5px 0;
      border: 1px solid #ddd;
      border-radius: 4px;
    }
    button {
      width: 100%;
      padding: 12px;
      background: #000;
      color: white;
      border: none;
      border-radius: 4px;
      cursor: pointer;
    }
    .links {
      text-align: center;
      margin-top: 20px;
    }
  </style>
</head>
<body>
  <h2>🔐 Login</h2>
  
  <form action="/auth/login<% if (typeof redirect !== 'undefined' && redirect) { %>?redirect=<%= redirect %><% } %>" method="POST">
    <div class="form-group">
      <input type="email" name="email" placeholder="Email" required>
    </div>
    
    <div class="form-group">
      <input type="password" name="motDePasse" placeholder="Mot de passe" required>
    </div>
    
    <button type="submit">Se connecter</button>
  </form>

  <div class="links">
    <a href="/auth/register">Créer un compte</a> | 
    <a href="/">Retour à l'accueil</a>
  </div>

  <% if (typeof redirect !== 'undefined' && redirect === 'commandes') { %>
    <script>
      console.log('🔗 Mode commandes activé - redirection après login');
    </script>
  <% } %>
</body>
</html>