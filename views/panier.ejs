<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <title>Panier</title>
  <style>
    .container { max-width: 1200px; margin: 0 auto; padding: 20px; }
    
    /* Styles pour le panier */
    .panier-item { 
      display: flex; 
      align-items: center; 
      padding: 15px; 
      border-bottom: 1px solid #eee;
      gap: 20px;
    }
    .produit-image { width: 100px; height: 100px; object-fit: cover; border-radius: 8px; }
    .produit-info { flex: 1; }
    .produit-nom { font-weight: bold; margin-bottom: 5px; }
    .produit-prix { color: #e60000; font-weight: bold; }
    .quantite-controls { display: flex; align-items: center; gap: 10px; }
    .total-section { 
      background: #f9f9f9; 
      padding: 20px; 
      margin-top: 20px; 
      border-radius: 8px;
      text-align: right;
    }
    .btn { 
      padding: 10px 20px; 
      background: #000; 
      color: white; 
      text-decoration: none; 
      border: none;
      border-radius: 4px;
      cursor: pointer;
      display: inline-block;
    }
    .btn-danger { background: #dc3545; }
    .btn-success { background: #28a745; }
    .empty-cart { text-align: center; padding: 40px; }
    .commande-form { margin-top: 20px; padding: 20px; background: #f0f8ff; border-radius: 8px; }

    /* Modal pour images agrandies */
    .modal-image {
      display: none;
      position: fixed;
      z-index: 1000;
      left: 0;
      top: 0;
      width: 100%;
      height: 100%;
      background-color: rgba(0,0,0,0.9);
      justify-content: center;
      align-items: center;
    }
    .modal-image-content {
      max-width: 90%;
      max-height: 90%;
      border-radius: 8px;
    }
    .close-modal {
      position: absolute;
      top: 20px;
      right: 35px;
      color: white;
      font-size: 40px;
      font-weight: bold;
      cursor: pointer;
    }
  </style>
</head>
<body>
  <div class="container">
    <h1>🛒 Mon Panier</h1>

    <!-- Section Panier -->
    <% if (panier.length === 0) { %>
      <div class="empty-cart">
        <h2>Votre panier est vide</h2>
        <p>Découvrez nos produits et ajoutez-les à votre panier !</p>
        
        <% 
        // DÉTERMINATION INTELLIGENTE DE L'URL DE RETOUR
        let returnUrl = '/';
        if (slug) {
            returnUrl = `/boutique/${slug}`;
        } else if (req.session.boutiqueActuelle) {
            returnUrl = `/boutique/${req.session.boutiqueActuelle}`;
        }
        %>
        
        <a href="<%= returnUrl %>" class="btn">← Retour à l'accueil</a>
      </div>
    <% } else { %>

      <div class="panier-items">
        <% panier.forEach(item => { %>
          <div class="panier-item">
            <% if (item.produit && item.produit.image) { %>
              <img src="<%= item.produit.image %>" alt="<%= item.produit.nom %>" class="produit-image">
            <% } %>
            
            <div class="produit-info">
              <div class="produit-nom">
                <%= item.produit ? item.produit.nom : 'Produit non disponible' %>
              </div>
              <div class="produit-prix">
                <%= item.produit ? item.produit.prix : '0' %> <%= item.produit ? item.produit.devise : '' %>
              </div>
              <div class="produit-vendeur">
                Vendeur: <%= item.produit && item.produit.vendeur ? item.produit.vendeur.nom : 'N/A' %>
              </div>
            </div>

            <div class="quantite-controls">
              <span>Quantité: <%= item.quantite %></span>
            </div>

            <div class="sous-total">
              <strong>
                <%= item.produit ? (item.produit.prix * item.quantite).toFixed(2) : '0.00' %> 
                <%= item.produit ? item.produit.devise : '' %>
              </strong>
            </div>

            <% if (item.produit) { %>
              <form action="/panier/supprimer/<%= item.produit._id %>" method="POST" style="display: inline;">
                <button type="submit" class="btn btn-danger">🗑 Supprimer</button>
              </form>
            <% } %>
          </div>
        <% }) %>
      </div>

      <div class="total-section">
        <h2>
          Total: 
          <% if (typeof total !== 'undefined') { %>
            <%= total.toFixed(2) %> 
          <% } else { %>
            0.00
          <% } %>
          <%= panier[0] && panier[0].produit ? panier[0].produit.devise : '' %>
        </h2>
      </div>

      <!-- Formulaire de commande -->
      <div class="commande-form">
        <h2>Finaliser ma commande</h2>
        <form action="/commandes/valider" method="POST">
          <div style="margin-bottom: 15px;">
            <label><strong>Nom complet :</strong></label><br>
            <input type="text" name="nom" required style="width: 100%; padding: 10px; margin-top: 5px;" placeholder="Votre nom complet">
          </div>
          
          <div style="margin-bottom: 15px;">
            <label><strong>Téléphone (WhatsApp) :</strong></label><br>
            <input type="text" name="telephone" required style="width: 100%; padding: 10px; margin-top: 5px;" placeholder="Votre numéro WhatsApp">
          </div>
          
          <div style="margin-bottom: 20px;">
            <label><strong>Adresse de livraison :</strong></label><br>
            <textarea name="adresse" required rows="3" style="width: 100%; padding: 10px; margin-top: 5px;" placeholder="Votre adresse complète de livraison"></textarea>
          </div>

          <div style="display: flex; gap: 10px;">
            <% 
            // DÉTERMINATION INTELLIGENTE DE L'URL POUR CONTINUER LES ACHATS
            let continueShoppingUrl = '/';
            if (slug) {
                continueShoppingUrl = `/boutique/${slug}`;
            } else if (panier.length > 0 && panier[0].produit && panier[0].produit.boutique && panier[0].produit.boutique.slug) {
                continueShoppingUrl = `/boutique/${panier[0].produit.boutique.slug}`;
            } else if (req.session.boutiqueActuelle) {
                continueShoppingUrl = `/boutique/${req.session.boutiqueActuelle}`;
            }
            %>
            
            <a href="<%= continueShoppingUrl %>" class="btn">← Continuer mes achats</a>
            <button type="submit" class="btn btn-success">✅ Valider ma commande</button>
          </div>
        </form>
      </div>

    <% } %>

  </div>

  <!-- Modal pour images agrandies -->
  <div id="imageModal" class="modal-image">
    <span class="close-modal" onclick="fermerModal()">&times;</span>
    <img class="modal-image-content" id="modalImage">
  </div>

  <script>
    // Fonctions pour les images
    function agrandirImage(element) {
      const modal = document.getElementById('imageModal');
      const modalImg = document.getElementById('modalImage');
      modal.style.display = 'flex';
      modalImg.src = element.src;
      modalImg.alt = element.alt;
    }

    function fermerModal() {
      const modal = document.getElementById('imageModal');
      modal.style.display = 'none';
    }

    // Fermer le modal en cliquant à l'extérieur
    document.getElementById('imageModal').addEventListener('click', function(e) {
      if (e.target === this) {
        fermerModal();
      }
    });

    // Fermer le modal avec la touche Échap
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') {
        fermerModal();
      }
    });
  </script>
</body>
</html>